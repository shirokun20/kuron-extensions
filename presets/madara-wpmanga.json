{
  "preset": "madara-wpmanga",
  "description": "Madara / WP-Manga theme family (.page-item-detail cards, li.wp-manga-chapter ajax chapter list, .reading-content img.wp-manga-chapter-img reader, /manga-genre/{tag}/ routes). Values are the dominant observed defaults; per-site files always win on values, and --check only requires that extended files contain these paths.",
  "defaults": {
    "scraper": {
      "enabled": true,
      "urlPatterns": {
        "home": {
          "url": "/manga/",
          "list": {
            "container": ".page-item-detail",
            "fields": {
              "id": {
                "selector": ".item-thumb a[href*='/manga/'], .post-title a[href*='/manga/']",
                "attribute": "href",
                "transform": "slug"
              },
              "title": {
                "transform": "cleanText",
                "selector": ".post-title h3 a, .post-title a"
              },
              "coverUrl": {
                "selector": ".item-thumb img",
                "attribute": "data-src"
              }
            },
            "pagination": {
              "mode": "paged",
              "next": "a[rel='next'], .pagination .next.page-numbers, li.pagination-next a"
            }
          }
        },
        "homePage": {
          "url": "/manga/page/{page}/",
          "inherits": "home"
        },
        "search": {
          "url": "/?s={query}&post_type=wp-manga",
          "list": {
            "container": ".row.c-tabs-item__content",
            "fields": {
              "id": {
                "selector": "a[href*='/manga/']",
                "attribute": "href",
                "transform": "slug"
              },
              "title": {
                "transform": "cleanText",
                "selector": ".post-title h3 a, .post-title a"
              },
              "coverUrl": {
                "selector": ".tab-thumb img",
                "attribute": "data-src"
              }
            },
            "pagination": {
              "next": "a[rel='next'], .pagination .next.page-numbers, li.pagination-next a"
            }
          }
        },
        "searchPage": {
          "url": "/page/{page}/?s={query}&post_type=wp-manga",
          "list": {
            "container": ".row.c-tabs-item__content",
            "fields": {
              "id": {
                "selector": "a[href*='/manga/']",
                "attribute": "href",
                "transform": "slug"
              },
              "title": {
                "transform": "cleanText",
                "selector": ".post-title h3 a, .post-title a"
              },
              "coverUrl": {
                "selector": ".tab-thumb img",
                "attribute": "data-src"
              }
            },
            "pagination": {
              "next": "a[rel='next'], .pagination .next.page-numbers, li.pagination-next a"
            }
          }
        },
        "genreSearch": {
          "url": "/manga-genre/{tag}/",
          "inherits": "home"
        },
        "genreSearchPage": {
          "url": "/manga-genre/{tag}/page/{page}/",
          "inherits": "home"
        },
        "detail": "/manga/{id}/",
        "chapter": "/manga/{id}"
      },
      "selectors": {
        "detail": {
          "fields": {
            "title": {
              "transform": "cleanText",
              "selector": ".post-title h1, h1"
            },
            "coverUrl": {
              "selector": ".summary_image img",
              "attribute": "data-src"
            },
            "description": {
              "selector": ".summary__content, .description-summary .summary__content"
            },
            "author": {
              "selector": ".author-content a",
              "multi": true,
              "extractTagObjects": true,
              "tagType": "author"
            },
            "artist": {
              "selector": ".artist-content a",
              "multi": true,
              "extractTagObjects": true,
              "tagType": "artist"
            },
            "tags": {
              "selector": ".genres-content a",
              "multi": true,
              "extractTagObjects": true,
              "tagType": "tag"
            }
          },
          "chapters": {
            "mode": "ajaxHtml",
            "container": "li.wp-manga-chapter",
            "fields": {
              "id": {
                "selector": "a",
                "attribute": "href",
                "regex": "/manga/([^?#]+)"
              },
              "title": {
                "transform": "cleanText",
                "selector": "a"
              },
              "date": {
                "selector": ".chapter-release-date i, .chapter-release-date a"
              }
            }
          }
        },
        "reader": {
          "mode": "chapterDataScript",
          "images": {
            "selector": ".reading-content img.wp-manga-chapter-img, .reading-content .page-break img",
            "attribute": "data-src"
          },
          "nav": {
            "next": ".next_page, .nav-links .next",
            "prev": ".prev_page, .nav-links .prev"
          }
        }
      },
      "searchForm": {
        "enabled": true,
        "urlPattern": "search",
        "params": {
          "query": {
            "queryParam": "s",
            "type": "text",
            "placeholder": "Search manga..."
          },
          "sort": {
            "queryParam": "m_orderby",
            "type": "select",
            "label": "Sort by",
            "options": [
              {
                "name": "Relevance",
                "value": ""
              },
              {
                "name": "Popular",
                "value": "popular"
              },
              {
                "name": "Latest",
                "value": "latest"
              },
              {
                "name": "A-Z",
                "value": "alphabet"
              },
              {
                "name": "Rating",
                "value": "rating"
              }
            ]
          }
        }
      }
    }
  }
}
