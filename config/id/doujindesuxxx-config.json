{
  "source": "doujindesuxxx",
  "version": "1.1.0.sf1",
  "enabled": false,
  "defaultLanguage": "indonesian",
  "baseUrl": "https://doujin.desu.xxx",
  "ui": {
    "displayName": "DoujinDesu.xxx",
    "iconPath": "./images/doujindesuxxx.png",
    "brandColor": "#181818",
    "openInBrowserUrl": "https://doujin.desu.xxx"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "x-app-secret": "dfdf72051dbfdc7d76889ebd31324e74",
      "Referer": "https://doujin.desu.xxx/",
      "Origin": "https://doujin.desu.xxx",
      "User-Agent": "Mozilla/5.0"
    }
  },
  "api": {
    "enabled": true,
    "url": "https://doujin.desu.xxx/api",
    "endpoints": {
      "allGalleries": "/api/manga?limit=30&offset={offset}",
      "latest": "/api/manga?limit=30&offset={offset}",
      "search": "/api/manga?limit=30&search={query}&offset={offset}",
      "detail": "/api/manga/{id}",
      "images": "/api/chapters/{chapterId}",
      "genres": "/api/genres?limit=1000"
    },
    "list": {
      "items": "$[*]",
      "fields": {
        "id": {
          "selector": "$.slug"
        },
        "title": {
          "selector": "$.title"
        },
        "coverUrl": {
          "selector": "$.cover_url"
        },
        "status": {
          "selector": "$.status"
        },
        "type": {
          "selector": "$.type"
        }
      }
    },
    "detail": {
      "fields": {
        "id": {
          "selector": "$.slug"
        },
        "title": {
          "selector": "$.title"
        },
        "description": {
          "selector": "$.description"
        },
        "coverUrl": {
          "selector": "$.cover_url"
        },
        "status": {
          "selector": "$.status"
        },
        "type": {
          "selector": "$.type"
        }
      },
      "chapters": {
        "endpoint": "/api/manga/{id}",
        "items": "$.chapters[*]",
        "fields": {
          "id": {
            "selector": "$.id"
          },
          "title": {
            "selector": "$.title"
          }
        }
      }
    },
    "images": {
      "mode": "direct",
      "items": "$.content_urls[*]"
    }
  },
  "features": {
    "home": true,
    "detail": true,
    "chapters": true,
    "reader": true,
    "download": true,
    "offlineMode": true,
    "comments": false,
    "favorite": true,
    "generatePdf": true
  },
  "notes": "Standalone source for the doujin.desu.xxx React SPA API. Encrypted _enc_resp_ payloads are decoded by the DoujinDesuXxxSourceFactory adapter (time-windowed hourly key, retry slot ±1) using only the static x-app-secret header — no WebView, no cookie warmup. THIS source uses a custom Dart adapter (adapterOverride); the api block is documentation only. Pagination = offset (0-based, 30/page), NOT page. Genre filter = genre=<slug> (ids resolved via /api/genres). Tags come from manga_genres + term_list. Reader pages come from chapter content_urls (WebP on amz-ch.desu.pics, requires Referer; signed URLs expire after 24h). Kept separate from the legacy doujindesuv2 HTML-scraper source.",
  "schemaVersion": "2.0",
  "searchForm": {
    "urlPattern": "search",
    "dataSources": {
      "genres": {
        "endpoint": "/api/genres?limit=1000",
        "itemsPath": "data",
        "valuePath": "id",
        "labelPath": "name"
      }
    },
    "params": {
      "query": {
        "queryParam": "search",
        "type": "text",
        "placeholder": "Search doujin..."
      },
      "genre": {
        "queryParam": "genre",
        "type": "tag",
        "label": "Genre",
        "ui": {
          "selector": "picker",
          "multi": true,
          "dataSource": "genres"
        }
      },
      "sort": {
        "queryParam": "",
        "type": "select",
        "label": "Sort by",
        "rawParam": true,
        "options": [
          {
            "name": "Latest",
            "value": "order[createdAt]=desc"
          },
          {
            "name": "Popular",
            "value": "order[views]=desc"
          },
          {
            "name": "Top Rated",
            "value": "order[rating]=desc"
          }
        ]
      }
    }
  }
}
