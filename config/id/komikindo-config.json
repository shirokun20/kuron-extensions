{
  "source": "komikindo",
  "schemaVersion": "2.0",
  "version": "1.0.5",
  "enabled": true,
  "defaultLanguage": "indonesian",
  "configUrl": "",
  "baseUrl": "https://komikindo.ch",
  "ui": {
    "displayName": "Komikindo",
    "iconPath": "./images/komikindo.png",
    "brandColor": "#E3456F",
    "openInBrowserUrl": "https://komikindo.ch/"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://komikindo.ch/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/komik-terbaru/",
        "list": {
          "container": ".animepost",
          "fields": {
            "id": {
              "selector": "a[href*='/komik/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".tt"
            },
            "coverUrl": {
              "selector": ".limit img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": ".pagination .next.page-numbers",
            "links": "a.page-numbers"
          }
        }
      },
      "homePage": {
        "url": "/komik-terbaru/page/{page}/",
        "inherits": "home"
      },
      "search": {
        "url": "/?s={query}",
        "inherits": "home"
      },
      "searchPage": {
        "url": "/page/{page}/?s={query}",
        "inherits": "home"
      },
      "genreSearch": {
        "url": "/genres/{tag}/",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/genres/{tag}/page/{page}/",
        "inherits": "home"
      },
      "detail": "/komik/{id}/",
      "chapter": "/{id}/"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "selector": ".entry-title, h1"
          },
          "coverUrl": {
            "selector": ".thumb img",
            "attribute": "src"
          },
          "tags": {
            "selector": ".genre-info a, a[href*='/genres/']",
            "multi": true,
            "extractTagObjects": true
          }
        },
        "chapters": {
          "container": "#chapter_list li",
          "fields": {
            "id": {
              "selector": "a",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".lchx a, a"
            },
            "date": {
              "selector": ".dt a, .dt"
            }
          }
        }
      },
      "reader": {
        "images": {
          "selector": ".chapter-image img, #chimg-auh img",
          "attribute": "src"
        },
        "nav": {
          "next": ".nextprev a.next, .nav-links a.next, .ch-next-btn",
          "prev": ".nextprev a.prev, .nav-links a.prev, .ch-prev-btn"
        }
      }
    }
  },
  "searchForm": {
    "urlPattern": "search",
    "params": {
      "query": {
        "queryParam": "s",
        "type": "text",
        "placeholder": "Cari komik..."
      },
      "page": {
        "queryParam": "page",
        "type": "page"
      }
    }
  },
  "contentIdPattern": "/komik/([^/]+)",
  "notes": "Migrated to official domain komikindo.ch (Ki-Newgen-Pagination theme). Home catalog canonical /komik-terbaru/ (40 items/page, numbered 1..233+ pagination). Search canonical /?s={query} and /page/{page}/?s={query}. Detail canonical /komik/{id}/ with #chapter_list li. Reader renders plain img elements inside .chapter-image img / #chimg-auh img. Genre archive /genres/{tag}/ and /genres/{tag}/page/{page}/.",
  "features": {
    "search": true,
    "chapters": true,
    "download": true,
    "favorite": true,
    "comments": false,
    "related": false,
    "generatePdf": true,
    "offlineMode": true
  }
}
