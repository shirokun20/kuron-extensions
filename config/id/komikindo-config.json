{
  "source": "komikindo",
  "schemaVersion": "2.0",
  "version": "1.0.0",
  "enabled": true,
  "defaultLanguage": "indonesian",
  "configUrl": "",
  "baseUrl": "https://komikindo.fit",
  "ui": {
    "displayName": "Komikindo",
    "iconPath": "./images/komikindo.png",
    "brandColor": "#E3456F",
    "openInBrowserUrl": "https://komikindo.fit"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://komikindo.fit/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/",
        "list": {
          "container": "div.bixbox:contains(Latest Update) .listupd .bsx",
          "fields": {
            "id": {
              "selector": "a[href]",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".tt"
            },
            "coverUrl": {
              "selector": ".limit img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": ".hpage a.r, .pagination .next.page-numbers"
          }
        }
      },
      "homePage": {
        "url": "/page/{page}/",
        "inherits": "home"
      },
      "search": {
        "url": "/?s={query}&paged={page}",
        "inherits": "home",
        "list": {
          "container": ".listupd .bsx"
        }
      },
      "genreSearch": {
        "url": "/genres/{tag}/",
        "inherits": "home",
        "list": {
          "container": ".listupd .bsx"
        }
      },
      "genreSearchPage": {
        "url": "/genres/{tag}/page/{page}/",
        "inherits": "home",
        "list": {
          "container": ".listupd .bsx"
        }
      },
      "detail": "/manga/{id}/",
      "chapter": "/{id}"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "selector": ".entry-title"
          },
          "coverUrl": {
            "selector": ".thumb img",
            "attribute": "src"
          },
          "tags": {
            "selector": ".seriestugenre a",
            "multi": true
          }
        },
        "chapters": {
          "container": "#chapterlist li",
          "fields": {
            "id": {
              "selector": ".chbox .eph-num a, a[href]",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".chbox .chapternum, .chapternum"
            },
            "date": {
              "selector": ".chbox .chapterdate, .chapterdate"
            }
          }
        }
      },
      "reader": {
        "tsReaderRegex": "ts_reader\\.run\\((.*?)\\);",
        "container": "#readerarea",
        "images": {
          "selector": "img",
          "attribute": "src"
        },
        "nav": {
          "next": ".nextprev a.next, .nav-links a.next, .ch-next-btn",
          "prev": ".nextprev a.prev, .nav-links a.prev, .ch-prev-btn"
        }
      }
    }
  },
  "searchForm": {
    "urlPattern": "search",
    "params": {
      "query": {
        "queryParam": "s",
        "type": "text",
        "placeholder": "Cari komik..."
      },
      "page": {
        "queryParam": "paged",
        "type": "page"
      }
    }
  },
  "contentIdPattern": "/manga/([^/]+)",
  "notes": "Mangathemesia. Home MUST scope to div.bixbox:contains(Latest Update): page has 7 bixbox sections (Popular/Project pollute, 71 vs 20 items). search/genreSearch/genreSearchPage override container back to plain .listupd .bsx (their pages have no Latest Update bixbox). Search uses ?s={query}&paged={page}.",
  "features": {
    "search": true,
    "chapters": true,
    "download": true,
    "favorite": true,
    "comments": false,
    "related": false,
    "generatePdf": true,
    "offlineMode": true
  }
}