{
  "source": "komikcast",
  "version": "1.2.2",
  "enabled": true,
  "defaultLanguage": "indonesian",
  "baseUrl": "https://12.voratoon.com",
  "configUrl": "https://raw.githubusercontent.com/shirokun20/kuron-extensions/main/config/id/komikcast-config.json",
  "ui": {
    "displayName": "Komikcast",
    "iconPath": "./images/komikcast.png",
    "brandColor": "#FF7043",
    "browseUrlTemplate": "{baseUrl}/browse",
    "searchUrlTemplate": "{baseUrl}/browse?q={query}"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "id-ID,id;q=0.9,en-US;q=0.8,en;q=0.7",
      "Referer": "https://12.voratoon.com/"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/browse",
        "list": {
          "container": "article.card",
          "fields": {
            "id": {
              "selector": "a.card-image-wrapper",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": "a.card-title"
            },
            "coverUrl": {
              "selector": "a.card-image-wrapper img",
              "attribute": "src"
            },
            "latestChapter": {
              "selector": ".card-meta .tag-chapters"
            }
          },
          "pagination": {
            "next": "a[aria-label='Halaman berikutnya']",
            "links": "a[href*='page=']"
          }
        }
      },
      "homePage": {
        "url": "/browse?page={page}",
        "inherits": "home"
      },
      "search": {
        "url": "/browse?q={query}",
        "inherits": "home"
      },
      "searchPage": {
        "url": "/browse?q={query}&page={page}",
        "inherits": "home"
      },
      "genreSearch": {
        "url": "/browse?genre={tag}",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/browse?genre={tag}&page={page}",
        "inherits": "home"
      },
      "detail": "/series/{id}",
      "chapter": "/{id}"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "selector": "h1.series-title"
          },
          "alternativeTitle": {
            "selector": "p.alternative-title",
            "optional": true
          },
          "coverUrl": {
            "selector": "img[alt^='Cover']",
            "attribute": "src"
          },
          "author": {
            "selector": ".info-list-item:contains('Author') strong",
            "optional": true
          },
          "status": {
            "selector": ".info-item:contains('Status') .info-val",
            "optional": true
          },
          "tags": {
            "selector": ".tags-container a.tag",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "tag"
          },
          "synopsis": {
            "selector": "p.synopsis"
          }
        },
        "chapters": {
          "container": "ul.chapter-list li",
          "fields": {
            "id": {
              "selector": "a.chapter-item",
              "attribute": "href"
            },
            "title": {
              "selector": ".chapter-number"
            },
            "date": {
              "selector": ".chapter-date"
            }
          }
        }
      },
      "reader": {
        "images": {
          "selector": "img[data-chapter-page]",
          "attribute": "data-chapter-page"
        }
      }
    }
  },
  "navigation": {
    "tagQueryMapping": {
      "default": {
        "mode": "rawParam",
        "param": "genre",
        "valueSource": "tagName"
      }
    }
  },
  "contentIdPattern": "/series/([^/]+)",
  "features": {
    "home": true,
    "search": true,
    "detail": true,
    "reader": true,
    "chapters": true,
    "download": true,
    "favorite": true,
    "offlineMode": true,
    "generatePdf": true,
    "comments": false,
    "related": false
  },
  "notes": "Komikcast pindah ke https://12.voratoon.com (frontend Next.js, SSR). API lama api.voratoon.com kini mengembalikan payload terenkripsi {encrypted: v1...} + header x-payload-encrypted sehingga mode API tidak bisa dipakai; config dialihkan ke scraper. Search SSR via /browse?q=, genre via /browse?genre=, pagination ?page=, reader via img[data-chapter-page]. pagination.next wajib chevron 'Halaman berikutnya' (bukan a[href*=page=]): tombol prev juga match page= sehingga cursor-cache adapter keracunan (page 4 baca URL page 2, dst; pola 1=3/2=4 di content-by-tag).",
  "searchForm": {
    "urlPattern": "search",
    "params": {
      "query": {
        "queryParam": "q",
        "type": "text",
        "placeholder": "Cari komik..."
      },
      "page": {
        "queryParam": "page",
        "type": "page"
      }
    }
  }
}
