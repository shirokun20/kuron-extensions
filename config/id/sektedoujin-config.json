{
  "source": "sektedoujin",
  "extends": "themesia",
  "idType": "slug",
  "schemaVersion": "2.0",
  "version": "1.0.3",
  "enabled": true,
  "defaultLanguage": "indonesian",
  "configUrl": "",
  "baseUrl": "https://sektedoujin.cc",
  "ui": {
    "displayName": "SekteDoujin",
    "iconPath": "./images/sektedoujin.png",
    "brandColor": "#9C27B0",
    "openInBrowserUrl": "https://sektedoujin.cc"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://sektedoujin.cc/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/",
        "list": {
          "container": ".listupd .utao",
          "fields": {
            "id": {
              "selector": "a.series[href*='/manga/'], .imgu a[href*='/manga/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".luf h4, .luf a h4"
            },
            "coverUrl": {
              "selector": ".imgu img, img.ts-post-image",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": ".hpage a.r, .pagination .next.page-numbers",
            "mode": "paged"
          }
        }
      },
      "homePage": {
        "url": "/page/{page}/",
        "inherits": "home"
      },
      "search": {
        "url": "/?s={query}&paged={page}",
        "list": {
          "container": ".listupd .bs .bsx",
          "fields": {
            "id": {
              "selector": "a[href]",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".tt"
            },
            "coverUrl": {
              "selector": ".limit img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": ".hpage a.r, .pagination .next.page-numbers",
            "mode": "paged"
          }
        }
      },
      "genreSearch": {
        "url": "/genres/{tag}/",
        "list": {
          "container": ".listupd .bs .bsx",
          "fields": {
            "id": {
              "selector": "a[href]",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".tt"
            },
            "coverUrl": {
              "selector": ".limit img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": ".hpage a.r, .pagination .next.page-numbers"
          }
        },
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/genres/{tag}/page/{page}/",
        "list": {
          "container": ".listupd .bs .bsx",
          "fields": {
            "id": {
              "selector": "a[href]",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".tt"
            },
            "coverUrl": {
              "selector": ".limit img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": ".hpage a.r, .pagination .next.page-numbers"
          }
        },
        "inherits": "home"
      },
      "detail": "/manga/{id}/",
      "chapter": "/{id}",
      "searchPage": {
        "list": {
          "container": ".listupd .bsx",
          "fields": {
            "coverUrl": {
              "attribute": "src",
              "selector": "img.ts-post-image"
            },
            "id": {
              "attribute": "href",
              "selector": "a",
              "transform": "slug"
            },
            "title": {
              "selector": ".tt",
              "transform": "cleanText"
            }
          },
          "pagination": {
            "mode": "paged",
            "next": "a[rel='next'], .pagination .next.page-numbers, li.pagination-next a"
          }
        },
        "url": "/page/{page}/?s={query}"
      }
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "transform": "cleanText",
            "selector": ".entry-title, h1.post-title"
          },
          "coverUrl": {
            "selector": ".thumb img",
            "attribute": "src"
          },
          "tags": {
            "selector": ".seriestugenre a, .mgen a",
            "multi": true,
            "extractTagObjects": true,
            "attribute": "href",
            "transform": "slug"
          }
        },
        "chapters": {
          "container": "#chapterlist li",
          "fields": {
            "id": {
              "selector": ".chbox .eph-num a, a[href]",
              "attribute": "href",
              "transform": "slug",
              "regex": "/([^?#/]+)/?$"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".chbox .chapternum, .chapternum"
            },
            "date": {
              "selector": ".chbox .chapterdate, .chapterdate"
            }
          }
        }
      },
      "reader": {
        "tsReaderRegex": "ts_reader\\.run\\((.*?)\\);",
        "container": "#readerarea",
        "images": {
          "selector": "#readerarea img",
          "attribute": "src"
        },
        "nav": {
          "next": ".nextprev a.next, .nav-links a.next, .ch-next-btn",
          "prev": ".nextprev a.prev, .nav-links a.prev, .ch-prev-btn"
        }
      }
    },
    "searchForm": {
      "enabled": true,
      "params": {
        "query": {
          "placeholder": "Search manga...",
          "queryParam": "s",
          "type": "text"
        },
        "sort": {
          "label": "Sort by",
          "options": [
            {
              "name": "Relevance",
              "value": ""
            },
            {
              "name": "Popular",
              "value": "popular"
            },
            {
              "name": "Latest",
              "value": "latest"
            },
            {
              "name": "A-Z",
              "value": "alphabet"
            },
            {
              "name": "Rating",
              "value": "rating"
            }
          ],
          "queryParam": "m_orderby",
          "type": "select"
        }
      },
      "urlPattern": "search"
    }
  },
  "searchForm": {
    "urlPattern": "search",
    "params": {
      "query": {
        "queryParam": "s",
        "type": "text",
        "placeholder": "Cari doujin..."
      },
      "page": {
        "queryParam": "paged",
        "type": "page"
      }
    }
  },
  "contentIdPattern": "/manga/([^/]+)",
  "features": {
    "chapters": true,
    "download": true,
    "favorite": true,
    "comments": false,
    "related": false,
    "generatePdf": true,
    "offlineMode": true
  },
  "notes": "| Reader images selector self-scoped (img -> #readerarea img): engine ignores reader.container; unscoped selector let a SERIES-slug download scrape junk imgs from detail page."
}
