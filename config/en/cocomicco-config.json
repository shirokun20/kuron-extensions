{
  "source": "cocomicco",
  "extends": "madara-wpmanga",
  "idType": "slug",
  "schemaVersion": "2.0",
  "version": "1.0.5",
  "enabled": true,
  "defaultLanguage": "english",
  "baseUrl": "https://cocomic.co",
  "ui": {
    "displayName": "Cocomic",
    "brandColor": "#FF6B35",
    "openInBrowserUrl": "https://cocomic.co"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://cocomic.co/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    },
    "imageHeaders": {
      "Referer": "https://cocomic.co/"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/manga/",
        "list": {
          "container": "article.asura-card",
          "fields": {
            "id": {
              "selector": ".asura-card-poster a[href*='/manga/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".asura-card-title"
            },
            "coverUrl": {
              "selector": ".asura-card-poster img",
              "attribute": "src"
            }
          },
          "pagination": {
            "mode": "paged",
            "next": ".asura-pagination a.next.page-numbers"
          }
        }
      },
      "homePage": {
        "url": "/manga/page/{page}/",
        "inherits": "home"
      },
      "search": {
        "url": "/?s={query}&post_type=wp-manga",
        "list": {
          "container": ".row.c-tabs-item__content",
          "fields": {
            "id": {
              "selector": "a[href*='/manga/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".tab-thumb img",
              "attribute": "data-src"
            }
          },
          "pagination": {
            "next": "a.page.larger, a[rel='next'], .pagination .next.page-numbers, li.pagination-next a"
          }
        }
      },
      "searchPage": {
        "url": "/page/{page}/?s={query}&post_type=wp-manga",
        "list": {
          "container": ".row.c-tabs-item__content",
          "fields": {
            "id": {
              "selector": "a[href*='/manga/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".tab-thumb img",
              "attribute": "data-src"
            }
          },
          "pagination": {
            "next": "a.page.larger, a[rel='next'], .pagination .next.page-numbers, li.pagination-next a"
          }
        }
      },
      "genreSearch": {
        "url": "/manga-genre/{tag}/",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/manga-genre/{tag}/page/{page}/",
        "inherits": "home"
      },
      "tagSearch": {
        "url": "/manga-tag/{tag}/",
        "inherits": "home"
      },
      "tagSearchPage": {
        "url": "/manga-tag/{tag}/page/{page}/",
        "inherits": "home"
      },
      "detail": "/manga/{id}/",
      "chapter": "/manga/{id}"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "transform": "cleanText",
            "selector": ".asura-series-title, h1"
          },
          "coverUrl": {
            "selector": ".asura-poster-img",
            "attribute": "src"
          },
          "description": {
            "selector": ".asura-synopsis-content"
          },
          "author": {
            "selector": ".asura-chip-author .author-name-text",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "author"
          },
          "artist": {
            "selector": ".asura-chip:contains(Artist:) .chip-val",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "artist"
          },
          "tags": {
            "selector": ".asura-genre-tag",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "tag"
          }
        },
        "chapters": {
          "mode": "ajaxHtml",
          "container": ".asura-chap-card",
          "fields": {
            "id": {
              "selector": "a.chap-card-left",
              "attribute": "href",
              "regex": "/manga/([^?#]+?)/?$"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".chap-name"
            },
            "date": {
              "selector": ".chap-time"
            }
          }
        }
      },
      "reader": {
        "mode": "chapterDataScript",
        "images": {
          "selector": ".reading-content img.wp-manga-chapter-img, .reading-content .page-break img",
          "attribute": "data-src"
        },
        "nav": {
          "next": ".next_page, .nav-links .next",
          "prev": ".prev_page, .nav-links .prev"
        }
      }
    },
    "searchForm": {
      "enabled": true,
      "urlPattern": "search",
      "params": {
        "query": {
          "queryParam": "s",
          "type": "text",
          "placeholder": "Search manga..."
        },
        "sort": {
          "queryParam": "m_orderby",
          "type": "select",
          "label": "Sort by",
          "options": [
            {
              "name": "Relevance",
              "value": ""
            },
            {
              "name": "Popular",
              "value": "popular"
            },
            {
              "name": "Latest",
              "value": "latest"
            },
            {
              "name": "A-Z",
              "value": "alphabet"
            },
            {
              "name": "Rating",
              "value": "rating"
            }
          ]
        }
      }
    }
  },
  "contentIdPattern": "/manga/([^/]+)",
  "features": {
    "search": true,
    "chapters": true,
    "download": true,
    "favorite": true,
    "comments": false,
    "related": false,
    "generatePdf": true,
    "offlineMode": true
  },
  "searchForm": {
    "urlPattern": "search",
    "params": {
      "query": {
        "queryParam": "s",
        "type": "text",
        "placeholder": "Search..."
      },
      "page": {
        "queryParam": "page",
        "type": "page"
      }
    }
  },
  "notes": "2026-11-23: search enabled after live verify (#59 audit: search 200 + matching items for 'webtoons', config container/id selectors match; minimal searchForm added). 2026-11-26: home/detail migrated to live article.asura-card / asura-series layout (24 cards, search .row.c-tabs-item__content unchanged); Item #61 canary drift."
}
