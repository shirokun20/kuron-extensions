{
  "source": "mangadass",
  "schemaVersion": "2.0",
  "version": "1.0.0",
  "enabled": true,
  "defaultLanguage": "english",
  "baseUrl": "https://mangadass.com",
  "ui": {
    "displayName": "Mangadass",
    "brandColor": "#FF6B35",
    "openInBrowserUrl": "https://mangadass.com"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://mangadass.com/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    },
    "imageHeaders": {
      "Referer": "https://mangadass.com/"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/manga/",
        "list": {
          "container": ".page-item-detail",
          "fields": {
            "id": {
              "selector": ".item-thumb a[href*='/manga/'], .item-title a[href*='/manga/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".item-title h3 a, .item-title a, .post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".item-thumb img",
              "attribute": "data-src"
            }
          },
          "pagination": {
            "mode": "paged",
            "next": ".blog-pager ul.pagination li.next a, a[rel='next'], .pagination .next.page-numbers, li.pagination-next a"
          }
        }
      },
      "homePage": {
        "url": "/manga/{page}",
        "inherits": "home"
      },
      "search": {
        "url": "/search?q={query}",
        "list": {
          "container": ".page-item-detail",
          "fields": {
            "id": {
              "selector": ".item-thumb a[href*='/manga/'], .item-title a[href*='/manga/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".item-title h3 a, .item-title a, .post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".item-thumb img",
              "attribute": "data-src"
            }
          },
          "pagination": {
            "next": ".blog-pager ul.pagination li.next a, a[rel='next'], .pagination .next.page-numbers, li.pagination-next a"
          }
        }
      },
      "searchPage": {
        "url": "/search?q={query}&page={page}",
        "list": {
          "container": ".page-item-detail",
          "fields": {
            "id": {
              "selector": ".item-thumb a[href*='/manga/'], .item-title a[href*='/manga/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".item-title h3 a, .item-title a, .post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".item-thumb img",
              "attribute": "data-src"
            }
          },
          "pagination": {
            "next": ".blog-pager ul.pagination li.next a, a[rel='next'], .pagination .next.page-numbers, li.pagination-next a"
          }
        }
      },
      "genreSearch": {
        "url": "/manga-genre/{tag}/",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/manga-genre/{tag}/{page}",
        "inherits": "home"
      },
      "detail": "/manga/{id}",
      "chapter": "/manga/{id}"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "selector": ".post-title h1, h1"
          },
          "coverUrl": {
            "selector": ".summary_image img",
            "attribute": "data-src"
          },
          "description": {
            "selector": ".panel-story-description .ss-manga, .summary__content, .description-summary .summary__content"
          },
          "author": {
            "selector": ".author-content a",
            "multi": true
          },
          "artist": {
            "selector": ".artist-content a",
            "multi": true
          },
          "tags": {
            "selector": ".genres-content a",
            "multi": true
          }
        },
        "chapters": {
          "container": "li.a-h",
          "fields": {
            "id": {
              "selector": "a.chapter-name",
              "attribute": "href",
              "regex": "/manga/([^?#]+?)/?$"
            },
            "title": {
              "selector": "a.chapter-name"
            },
            "date": {
              "selector": ".chapter-time"
            }
          }
        }
      },
      "reader": {
        "mode": "chapterDataScript",
        "images": {
          "selector": ".read-content img",
          "attribute": "data-src"
        },
        "nav": {
          "next": ".next_page, .nav-links .next",
          "prev": ".prev_page, .nav-links .prev"
        }
      }
    },
    "searchForm": {
      "enabled": true,
      "urlPattern": "search",
      "params": {
        "query": {
          "queryParam": "q",
          "type": "text",
          "placeholder": "Search manga..."
        },
        "sort": {
          "queryParam": "m_orderby",
          "type": "select",
          "label": "Sort by",
          "options": [
            {
              "name": "Relevance",
              "value": ""
            },
            {
              "name": "Popular",
              "value": "popular"
            },
            {
              "name": "Latest",
              "value": "latest"
            },
            {
              "name": "A-Z",
              "value": "alphabet"
            },
            {
              "name": "Rating",
              "value": "rating"
            }
          ]
        }
      }
    }
  },
  "contentIdPattern": "/manga/([^/]+)",
  "features": {
    "search": false,
    "chapters": true,
    "download": true,
    "favorite": true,
    "comments": false,
    "related": false,
    "generatePdf": true,
    "offlineMode": true
  }
}