{
  "source": "mangafire",
  "version": "1.1.2",
  "enabled": true,
  "requiresSpecialAdapter": true,
  "defaultLanguage": "en",
  "baseUrl": "https://mangafire.to",
  "ui": {
    "displayName": "MangaFire",
    "iconPath": "./images/mangafire.png",
    "brandColor": "#ef4444",
    "openInBrowserUrl": "https://mangafire.to"
  },
  "network": {
    "requiresBypass": true,
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Referer": "https://mangafire.to/"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 2,
      "maxConcurrentRequests": 1
    },
    "auth": {
      "enabled": true,
      "authType": "vrf",
      "captureUrl": "https://mangafire.to/",
      "vrfParam": "vrf",
      "ttlSeconds": 300,
      "cacheMaxEntries": 20,
      "interceptEndpoints": [
        "/api/titles",
        "/api/chapters"
      ]
    }
  },
  "api": {
    "enabled": true,
    "endpoints": {
      "allGalleries": "/api/titles?page={page}&{sort}",
      "search": "/api/titles?page={page}&keyword={query}&{sort}",
      "detail": "/api/titles/{id}",
      "contentUrl": "https://mangafire.to/manga/{id}",
      "images": "/api/chapters/{chapterId}"
    },
    "list": {
      "items": "$.items[*]",
      "pagination": {
        "currentPage": {
          "path": "$.meta.page"
        },
        "totalPages": {
          "path": "$.meta.lastPage"
        }
      },
      "fields": {
        "id": {
          "selector": "$.hid"
        },
        "title": {
          "selector": "$.title"
        },
        "coverUrl": {
          "selector": "$.poster.large"
        },
        "status": {
          "selector": "$.status"
        },
        "type": {
          "selector": "$.type"
        },
        "pageCount": {
          "selector": "$.latestChapter"
        }
      }
    },
    "detail": {
      "tagRelations": {
        "mappings": [
          {
            "sourcePath": "$.data.genres[*]",
            "tagType": "tag",
            "namePath": "title",
            "idPath": "id"
          },
          {
            "sourcePath": "$.data.authors[*]",
            "tagType": "artist",
            "namePath": "title",
            "idPath": "id",
            "appendToArtists": true
          }
        ]
      },
      "fields": {
        "id": {
          "selector": "$.data.hid"
        },
        "title": {
          "selector": "$.data.title"
        },
        "description": {
          "selector": "$.data.synopsisHtml"
        },
        "coverUrl": {
          "selector": "$.data.poster.large"
        },
        "status": {
          "selector": "$.data.status"
        },
        "type": {
          "selector": "$.data.type"
        },
        "availableTranslatedLanguages": {
          "selector": "$.data.languages[*]",
          "multi": true
        },
        "language": {
          "selector": "$.data.languages[0]"
        },
        "uploadDate": {
          "selector": "$.data.createdAt"
        }
      },
      "chapters": {
        "endpoint": "/api/titles/{id}/chapters?language={language}&sort=number&order=asc&limit=100",
        "autoPaginate": false,
        "items": "$.items[*]",
        "fields": {
          "id": {
            "selector": "$.id",
            "prefix": "https://mangafire.to/api/chapters/"
          },
          "chapterNum": {
            "selector": "$.number"
          },
          "title": {
            "selector": "$.name"
          },
          "url": {
            "selector": "$.id"
          },
          "date": {
            "selector": "$.createdAt"
          },
          "language": {
            "selector": "$.language"
          },
          "scanGroup": {
            "value": "Chapter"
          }
        }
      },
      "volumes": {
        "endpoint": "/api/titles/{id}/volumes?language={language}",
        "autoPaginate": false,
        "items": "$.items[*]",
        "fields": {
          "id": {
            "selector": "$.id",
            "prefix": "https://mangafire.to/api/volumes/"
          },
          "volume": {
            "selector": "$.number"
          },
          "title": {
            "selector": "$.name"
          },
          "url": {
            "selector": "$.id"
          },
          "date": {
            "selector": "$.createdAt"
          },
          "language": {
            "selector": "$.language"
          },
          "scanGroup": {
            "value": "Volume"
          }
        }
      }
    },
    "images": {
      "mode": "direct",
      "items": "$.data.pages[*].url"
    }
  },
  "navigation": {
    "tagQueryMapping": {
      "artist": {
        "mode": "rawParam",
        "param": "authors[]",
        "valueSource": "tagId"
      },
      "tag": {
        "mode": "rawParam",
        "param": "genres_in[]",
        "valueSource": "tagId"
      },
      "type": {
        "mode": "rawParam",
        "param": "types[]",
        "valueSource": "tagName"
      }
    }
  },
  "searchForm": {
    "urlPattern": "search",
    "params": {
      "query": {
        "queryParam": "keyword",
        "type": "text",
        "placeholder": "Search MangaFire..."
      }
    }
  },
  "contentIdPattern": "/manga/([^/?#]+)",
  "features": {
    "home": true,
    "search": true,
    "dynamicForm": false,
    "contentByTag": true,
    "detail": true,
    "chapters": true,
    "reader": true,
    "download": true,
    "related": true,
    "comments": false,
    "favorite": true,
    "offlineMode": true,
    "generatePdf": true
  },
  "maintenance": false
}
