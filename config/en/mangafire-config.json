{
  "source": "mangafire",
  "version": "1.1.4",
  "enabled": true,
  "requiresSpecialAdapter": true,
  "defaultLanguage": "en",
  "baseUrl": "https://mangafire.to",
  "ui": {
    "displayName": "MangaFire",
    "iconPath": "./images/mangafire.png",
    "brandColor": "#ef4444",
    "openInBrowserUrl": "https://mangafire.to"
  },
  "network": {
    "requiresBypass": true,
    "detailTimeoutSeconds": 150,
    "allowedHosts": [
      "mangafire.to",
      ".mangafire.to",
      "s.mfcdn.nl",
      ".s.mfcdn.nl",
      "challenges.cloudflare.com"
    ],
    "initializationScript": "(function () {\n    try {\n        const key = 'mf_content_prefs';\n        const prefs = {\n            allowedTypes: null,\n            allowedContentRatings: null,\n            allowedDemographics: null,\n            blockedGenres: [],\n            blockedThemes: []\n        };\n        localStorage.setItem(key, JSON.stringify(prefs));\n    } catch (e) {}\n})();",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Referer": "https://mangafire.to/"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 2,
      "maxConcurrentRequests": 1
    },
    "auth": {
      "enabled": true,
      "authType": "vrf",
      "captureUrl": "https://mangafire.to/",
      "vrfParam": "vrf",
      "ttlSeconds": 300,
      "cacheMaxEntries": 20,
      "interceptEndpoints": [
        "/api/titles",
        "/api/chapters"
      ]
    }
  },
  "api": {
    "enabled": true,
    "endpoints": {
      "allGalleries": "/api/titles?page={page}&{sort}",
      "search": "/api/titles?page={page}&keyword={query}&{sort}",
      "detail": "/api/titles/{id}",
      "contentUrl": "https://mangafire.to/manga/{id}",
      "images": "/api/chapters/{chapterId}"
    },
    "list": {
      "items": "$.items[*]",
      "pagination": {
        "currentPage": {
          "path": "$.meta.page"
        },
        "totalPages": {
          "path": "$.meta.lastPage"
        }
      },
      "fields": {
        "id": {
          "selector": "$.hid"
        },
        "title": {
          "selector": "$.title"
        },
        "coverUrl": {
          "selector": "$.poster.large"
        },
        "status": {
          "selector": "$.status"
        },
        "type": {
          "selector": "$.type"
        },
        "pageCount": {
          "selector": "$.latestChapter"
        }
      }
    },
    "detail": {
      "tagRelations": {
        "mappings": [
          {
            "sourcePath": "$.data.genres[*]",
            "tagType": "tag",
            "namePath": "title",
            "idPath": "id"
          },
          {
            "sourcePath": "$.data.authors[*]",
            "tagType": "artist",
            "namePath": "title",
            "idPath": "id",
            "appendToArtists": true
          }
        ]
      },
      "fields": {
        "id": {
          "selector": "$.data.hid"
        },
        "title": {
          "selector": "$.data.title"
        },
        "description": {
          "selector": "$.data.synopsisHtml"
        },
        "coverUrl": {
          "selector": "$.data.poster.large"
        },
        "status": {
          "selector": "$.data.status"
        },
        "type": {
          "selector": "$.data.type"
        },
        "availableTranslatedLanguages": {
          "selector": "$.data.languages[*]",
          "multi": true
        },
        "language": {
          "selector": "$.data.languages[0]"
        },
        "uploadDate": {
          "selector": "$.data.createdAt"
        }
      },
      "chapters": {
        "endpoint": "/api/titles/{id}/chapters?language={language}&sort=number&order=asc&limit=100",
        "autoPaginate": false,
        "items": "$.items[*]",
        "fields": {
          "id": {
            "selector": "$.id",
            "prefix": "https://mangafire.to/api/chapters/"
          },
          "chapterNum": {
            "selector": "$.number"
          },
          "title": {
            "selector": "$.name"
          },
          "url": {
            "selector": "$.id"
          },
          "date": {
            "selector": "$.createdAt"
          },
          "language": {
            "selector": "$.language"
          },
          "scanGroup": {
            "value": "Chapter"
          }
        }
      },
      "volumes": {
        "endpoint": "/api/titles/{id}/volumes?language={language}",
        "autoPaginate": false,
        "items": "$.items[*]",
        "fields": {
          "id": {
            "selector": "$.id",
            "prefix": "https://mangafire.to/api/volumes/"
          },
          "volume": {
            "selector": "$.number"
          },
          "title": {
            "selector": "$.name"
          },
          "url": {
            "selector": "$.id"
          },
          "date": {
            "selector": "$.createdAt"
          },
          "language": {
            "selector": "$.language"
          },
          "scanGroup": {
            "value": "Volume"
          }
        }
      }
    },
    "images": {
      "mode": "direct",
      "items": "$.data.pages[*].url"
    }
  },
  "navigation": {
    "tagQueryMapping": {
      "artist": {
        "mode": "rawParam",
        "param": "authors[]",
        "valueSource": "tagId"
      },
      "tag": {
        "mode": "rawParam",
        "param": "genres_in[]",
        "valueSource": "tagId"
      },
      "genre": {
        "mode": "rawParam",
        "param": "genres_in[]",
        "valueSource": "tagId"
      },
      "type": {
        "mode": "rawParam",
        "param": "types[]",
        "valueSource": "tagName"
      }
    }
  },
  "adapterConfig": {
    "endpoint": "/browse",
    "queryParam": "keyword",
    "sortParam": "sort",
    "keywordSort": "relevance:desc",
    "sortValues": {
      "popular": "views_total:desc",
      "popularToday": "views_total:desc",
      "popularWeek": "views_total:desc",
      "popularMonth": "views_total:desc",
      "rating": "views_total:desc",
      "newest": "chapter_updated_at:desc"
    },
    "defaultParams": {
      "content_rating": "none"
    }
  },
  "genreMapping": {
    "action": "1",
    "adult": "268929",
    "adventure": "78",
    "avant garde": "3",
    "boys love": "4",
    "comedy": "5",
    "crime": "268921",
    "demons": "77",
    "drama": "6",
    "ecchi": "7",
    "fantasy": "79",
    "girls love": "9",
    "gourmet": "10",
    "harem": "11",
    "hentai": "268930",
    "historical": "268922",
    "horror": "530",
    "isekai": "13",
    "iyashikei": "531",
    "josei": "15",
    "kids": "532",
    "magic": "539",
    "magical girls": "268923",
    "mahou shoujo": "533",
    "martial arts": "534",
    "mature": "268931",
    "mecha": "19",
    "medical": "268924",
    "military": "535",
    "music": "21",
    "mystery": "22",
    "parody": "23",
    "philosophical": "268925",
    "psychological": "536",
    "reverse harem": "25",
    "romance": "26",
    "school": "73",
    "sci-fi": "28",
    "seinen": "537",
    "shoujo": "30",
    "shounen": "31",
    "slice of life": "538",
    "smut": "268932",
    "space": "33",
    "sports": "34",
    "super power": "75",
    "superhero": "268926",
    "supernatural": "76",
    "suspense": "37",
    "thriller": "38",
    "tragedy": "268927",
    "vampire": "39",
    "wuxia": "268928"
  },
  "searchForm": {
    "urlPattern": "search",
    "params": {
      "query": {
        "queryParam": "keyword",
        "type": "text",
        "placeholder": "Search MangaFire..."
      }
    }
  },
  "contentIdPattern": "/manga/([^/?#]+)",
  "features": {
    "home": true,
    "search": true,
    "dynamicForm": false,
    "contentByTag": true,
    "detail": true,
    "chapters": true,
    "reader": true,
    "download": true,
    "related": false,
    "comments": false,
    "favorite": true,
    "offlineMode": true,
    "generatePdf": true
  },
  "maintenance": false
}
