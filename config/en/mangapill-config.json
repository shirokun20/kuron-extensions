{
  "source": "mangapill",
  "displayName": "MangaPill",
  "schemaVersion": "2.0",
  "version": "1.0.1",
  "enabled": true,
  "defaultLanguage": "english",
  "baseUrl": "https://mangapill.com",
  "configUrl": "https://raw.githubusercontent.com/shirokun20/kuron-config-providers/main/configs/mangapill-config.json",
  "ui": {
    "displayName": "MangaPill",
    "iconPath": "./images/mangapill.png",
    "brandColor": "#a855f7",
    "openInBrowserUrl": "https://mangapill.com"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://mangapill.com/",
      "User-Agent": "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.6099.230 Mobile Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "en-US,en;q=0.9"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 2,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/mangas/new",
        "list": {
          "container": ".grid.justify-end.gap-3 > div",
          "pagination": {
            "next": "a.btn.btn-sm"
          },
          "fields": {
            "id": {
              "selector": "a[href^=\"/manga/\"]",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".mt-3.font-black.leading-tight.line-clamp-2"
            },
            "coverUrl": {
              "selector": "img.lazy.object-cover",
              "attribute": "src"
            }
          }
        }
      },
      "search": {
        "url": "/search?q={query}",
        "inherits": "home"
      },
      "searchPage": {
        "url": "/search?q={query}&page={page}",
        "inherits": "home"
      },
      "genreSearch": {
        "url": "/search?genre={tag}",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/search?genre={tag}&page={page}",
        "inherits": "home"
      },
      "detail": "/manga/{id}",
      "chapter": "/chapters/{id}"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "selector": "meta[property=\"og:title\"]",
            "attribute": "content",
            "regex": "^(.*?)\\s*-\\s*Mangapill$"
          },
          "coverUrl": {
            "selector": "img.lazy.absolute.inset-0",
            "attribute": "src"
          },
          "description": {
            "selector": "meta[property=\"og:description\"]",
            "attribute": "content"
          },
          "tags": {
            "selector": "a[href*=\"/search?genre=\"]",
            "multi": true
          }
        },
        "chapters": {
          "container": "div#chapters a.border.border-border.p-1",
          "fields": {
            "id": {
              "selector": "a.border.border-border.p-1",
              "attribute": "href"
            },
            "title": {
              "selector": "a.border.border-border.p-1"
            }
          }
        }
      },
      "reader": {
        "images": {
          "selector": "img.js-page",
          "attribute": "data-src"
        },
        "nav": {
          "next": "a[data-hotkey=\"ArrowRight\"]",
          "prev": "a[data-hotkey=\"ArrowLeft\"]"
        }
      }
    }
  },
  "searchForm": {
    "urlPattern": "search",
    "params": {
      "query": {
        "queryParam": "q",
        "type": "text",
        "placeholder": "Search manga title..."
      },
      "type": {
        "queryParam": "type",
        "type": "select",
        "label": "Type",
        "options": [
          {
            "name": "All",
            "value": ""
          },
          {
            "name": "Manga",
            "value": "manga"
          },
          {
            "name": "Novel",
            "value": "novel"
          },
          {
            "name": "One-shot",
            "value": "one-shot"
          },
          {
            "name": "Doujinshi",
            "value": "doujinshi"
          },
          {
            "name": "Manhua",
            "value": "manhua"
          },
          {
            "name": "OEL",
            "value": "oel"
          }
        ]
      },
      "status": {
        "queryParam": "status",
        "type": "select",
        "label": "Status",
        "options": [
          {
            "name": "All",
            "value": ""
          },
          {
            "name": "Publishing",
            "value": "publishing"
          },
          {
            "name": "Finished",
            "value": "finished"
          },
          {
            "name": "On Hiatus",
            "value": "on hiatus"
          },
          {
            "name": "Discontinued",
            "value": "discontinued"
          },
          {
            "name": "Not Yet Published",
            "value": "not yet published"
          }
        ]
      },
      "page": {
        "queryParam": "page",
        "type": "page"
      },
      "genre": {
        "queryParam": "genre",
        "type": "checkbox",
        "label": "Genre",
        "options": [
          "Action",
          "Adventure",
          "Cars",
          "Comedy",
          "Dementia",
          "Demons",
          "Doujinshi",
          "Drama",
          "Ecchi",
          "Fantasy",
          "Game",
          "Gender Bender",
          "Harem",
          "Historical",
          "Horror",
          "Isekai",
          "Josei",
          "Kids",
          "Magic",
          "Martial Arts",
          "Mecha",
          "Military",
          "Music",
          "Mystery",
          "Parody",
          "Police",
          "Psychological",
          "Romance",
          "Samurai",
          "School",
          "Sci-Fi",
          "Seinen",
          "Shoujo",
          "Shoujo Ai",
          "Shounen",
          "Shounen Ai",
          "Slice of Life",
          "Space",
          "Sports",
          "Super Power",
          "Supernatural",
          "Thriller",
          "Tragedy",
          "Vampire",
          "Yaoi",
          "Yuri"
        ]
      }
    }
  },
  "contentIdPattern": "^\\d+$",
  "navigation": {
    "genreQueryPrefix": "genre:",
    "genreTagType": "genre",
    "tagQueryMapping": {
      "genre": {
        "mode": "rawParam",
        "param": "genre",
        "valueSource": "tagId"
      }
    }
  },
  "features": {
    "home": true,
    "detail": true,
    "reader": true,
    "download": true,
    "chapters": true,
    "comments": false,
    "offlineMode": true,
    "favorite": true,
    "generatePdf": true,
    "related": false
  },
  "notes": "MangaPill — pure HTML scraper. Tailwind CSS. Images on cdn.readdetectiveconan.com CDN. Trending manga grid on home page. Search via /search?q={query}. No Cloudflare protection. Chapter IDs follow /chapters/{mangaId}-{chapterNum}/{slug} format. Chapter page images extracted via img.js-page[data-src]."
}
