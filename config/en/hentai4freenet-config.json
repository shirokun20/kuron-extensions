{
  "source": "hentai4freenet",
  "idType": "slug",
  "schemaVersion": "2.0",
  "version": "1.0.9",
  "enabled": true,
  "defaultLanguage": "english",
  "baseUrl": "https://hentai4free.net",
  "ui": {
    "displayName": "Hentai4free",
    "brandColor": "#FF6B35",
    "openInBrowserUrl": "https://hentai4free.net"
  },
  "network": {
    "requiresBypass": true,
    "headers": {
      "Referer": "https://hentai4free.net/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "en-US,en;q=0.9"
    },
    "imageHeaders": {
      "Referer": "https://hentai4free.net/"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/",
        "list": {
          "container": ".page-item-detail",
          "fields": {
            "id": {
              "selector": ".item-thumb a[href*='/hentai/'], .post-title a[href*='/hentai/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".item-thumb img",
              "attribute": "src"
            }
          },
          "pagination": {
            "mode": "paged",
            "next": "a[rel='next']"
          }
        }
      },
      "homePage": {
        "url": "/page/{page}/",
        "inherits": "home"
      },
      "search": {
        "url": "/?s={query}&post_type=wp-manga",
        "list": {
          "container": ".h4f-manga-grid-cell",
          "fields": {
            "id": {
              "selector": ".item-thumb a[href*='/hentai/'], .post-title a[href*='/hentai/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".item-thumb img",
              "attribute": "src"
            }
          },
          "pagination": {
            "mode": "paged",
            "next": "a[rel='next'], .pagination .next.page-numbers, li.pagination-next a"
          }
        }
      },
      "searchPage": {
        "url": "/page/{page}/?s={query}&post_type=wp-manga",
        "list": {
          "container": ".h4f-manga-grid-cell",
          "fields": {
            "id": {
              "selector": ".item-thumb a[href*='/hentai/'], .post-title a[href*='/hentai/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".item-thumb img",
              "attribute": "src"
            }
          },
          "pagination": {
            "mode": "paged",
            "next": "a[rel='next'], .pagination .next.page-numbers, li.pagination-next a"
          }
        }
      },
      "genreSearch": {
        "url": "/hentai-genre/{tag}/",
        "list": {
          "container": ".h4f-genre-grid article.h4f-genre-card",
          "fields": {
            "id": {
              "selector": "a.h4f-genre-card__cover",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "transform": "cleanText",
              "selector": "h2.h4f-genre-card__title a"
            },
            "coverUrl": {
              "selector": "a.h4f-genre-card__cover img",
              "attribute": "src"
            }
          },
          "pagination": {
            "mode": "paged",
            "next": "a.next.page-numbers",
            "links": "nav.h4f-genre-pagination a.page-numbers"
          }
        }
      },
      "genreSearchPage": {
        "url": "/hentai-genre/{tag}/page/{page}/",
        "inherits": "genreSearch"
      },
      "tagSearch": {
        "url": "/hentai-tag/{tag}/",
        "list": {
          "container": ".h4f-genre-grid article.h4f-genre-card",
          "fields": {
            "id": {
              "selector": "a.h4f-genre-card__cover",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "transform": "cleanText",
              "selector": "h2.h4f-genre-card__title a"
            },
            "coverUrl": {
              "selector": "a.h4f-genre-card__cover img",
              "attribute": "src"
            }
          },
          "pagination": {
            "mode": "paged",
            "next": "a.next.page-numbers",
            "links": "nav.h4f-genre-pagination a.page-numbers"
          }
        }
      },
      "tagSearchPage": {
        "url": "/hentai-tag/{tag}/page/{page}/",
        "inherits": "tagSearch"
      },
      "authorSearch": {
        "url": "/hentai-author/{tag}/",
        "inherits": "tagSearch"
      },
      "authorSearchPage": {
        "url": "/hentai-author/{tag}/page/{page}/",
        "inherits": "authorSearch"
      },
      "artistSearch": {
        "url": "/hentai-artist/{tag}/",
        "inherits": "tagSearch"
      },
      "artistSearchPage": {
        "url": "/hentai-artist/{tag}/page/{page}/",
        "inherits": "artistSearch"
      },
      "detail": "/hentai/{id}/",
      "chapter": "/hentai/{id}/"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "transform": "cleanText",
            "selector": ".post-title h1, h1"
          },
          "coverUrl": {
            "selector": ".summary_image img",
            "attribute": "data-src"
          },
          "author": {
            "selector": ".author-content a",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "author"
          },
          "artist": {
            "selector": ".artist-content a",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "artist"
          },
          "genres": {
            "selector": ".genres-content a",
            "extractTagObjects": true,
            "tagType": "genre"
          },
          "tags": {
            "selector": ".tags-content a",
            "extractTagObjects": true,
            "tagType": "tag"
          }
        },
        "chapters": {
          "container": "a.h4f-oneshot-read-direct",
          "fields": {
            "id": {
              "selector": "self",
              "attribute": "href",
              "regex": "/hentai/([^?#]+?)/?$"
            },
            "title": {
              "transform": "cleanText",
              "selector": "self"
            }
          }
        }
      },
      "reader": {
        "images": {
          "scriptJson": {
            "id": "h4f-r2-data",
            "items": "images",
            "url": "src"
          }
        }
      }
    },
    "searchForm": {
      "enabled": true,
      "urlPattern": "search",
      "params": {
        "query": {
          "queryParam": "s",
          "type": "text",
          "placeholder": "Search manga..."
        },
        "sort": {
          "queryParam": "m_orderby",
          "type": "select",
          "label": "Sort by",
          "options": [
            {
              "name": "Relevance",
              "value": ""
            },
            {
              "name": "Popular",
              "value": "popular"
            },
            {
              "name": "Latest",
              "value": "latest"
            },
            {
              "name": "A-Z",
              "value": "alphabet"
            },
            {
              "name": "Rating",
              "value": "rating"
            }
          ]
        }
      }
    }
  },
  "contentIdPattern": "/hentai/([^/?#]+)",
  "features": {
    "search": false,
    "chapters": true,
    "download": true,
    "favorite": true,
    "comments": false,
    "related": false,
    "generatePdf": true,
    "offlineMode": true
  },
  "notes": "2026-11-23: requiresBypass:true + browser headers (#59 audit: search intermittently 403 cf-mitigated while home 200 — same signature as #21; bypass stays lazy). Search NOT enabled: search page carries a challenge-platform marker with zero .h4f-manga-grid-cell items via plain HTTP — needs bypassed live re-verify before features.search:true."
}
