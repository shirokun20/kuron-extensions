{
  "source": "manhwatoon",
  "schemaVersion": "2.0",
  "version": "1.0.2",
  "enabled": true,
  "defaultLanguage": "english",
  "baseUrl": "https://www.manhwatoon.me",
  "ui": {
    "displayName": "Manhwatoon",
    "brandColor": "#FF6B35",
    "openInBrowserUrl": "https://www.manhwatoon.me"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://www.manhwatoon.me/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    },
    "imageHeaders": {
      "Referer": "https://www.manhwatoon.me/"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/manhwa/",
        "list": {
          "container": ".page-item-detail",
          "fields": {
            "id": {
              "selector": ".item-thumb a[href*='/manhwa/'], .post-title a[href*='/manhwa/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".item-thumb img",
              "attribute": "data-src"
            }
          },
          "pagination": {
            "mode": "paged",
            "next": ".nav-links .nav-previous a, a[rel='next']"
          }
        }
      },
      "homePage": {
        "url": "/manhwa/page/{page}/",
        "inherits": "home"
      },
      "search": {
        "url": "/?s={query}&post_type=wp-manga",
        "list": {
          "container": ".row.c-tabs-item__content",
          "fields": {
            "id": {
              "selector": "a[href*='/manhwa/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".tab-thumb img",
              "attribute": "data-src"
            }
          },
          "pagination": {
            "next": ".nav-links .nav-previous a, a[rel='next']"
          }
        }
      },
      "searchPage": {
        "url": "/page/{page}/?s={query}&post_type=wp-manga",
        "list": {
          "container": ".row.c-tabs-item__content",
          "fields": {
            "id": {
              "selector": "a[href*='/manhwa/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".tab-thumb img",
              "attribute": "data-src"
            }
          },
          "pagination": {
            "next": ".nav-links .nav-previous a, a[rel='next']"
          }
        }
      },
      "genreSearch": {
        "url": "/manhwa-genre/{tag}/",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/manhwa-genre/{tag}/page/{page}/",
        "inherits": "home"
      },
      "detail": "/manhwa/{id}/",
      "chapter": "/manhwa/{id}/"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "selector": ".post-title h1, h1"
          },
          "coverUrl": {
            "selector": ".summary_image img",
            "attribute": "data-src"
          },
          "description": {
            "selector": ".summary__content, .description-summary .summary__content"
          },
          "author": {
            "selector": ".author-content a",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "author"
          },
          "artist": {
            "selector": ".artist-content a",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "artist"
          },
          "tags": {
            "selector": ".genres-content a",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "tag"
          }
        },
        "chapters": {
          "mode": "ajaxHtml",
          "container": "li.wp-manga-chapter",
          "fields": {
            "id": {
              "selector": "a",
              "attribute": "href",
              "regex": "/manhwa/([^?#]+)"
            },
            "title": {
              "selector": "a"
            },
            "date": {
              "selector": ".chapter-release-date i, .chapter-release-date a"
            }
          }
        }
      },
      "reader": {
        "mode": "chapterDataScript",
        "images": {
          "selector": ".reading-content img.wp-manga-chapter-img, .reading-content .page-break img",
          "attribute": "data-src"
        },
        "nav": {
          "next": ".next_page, .nav-links .next",
          "prev": ".prev_page, .nav-links .prev"
        }
      }
    },
    "searchForm": {
      "enabled": true,
      "urlPattern": "search",
      "params": {
        "query": {
          "queryParam": "s",
          "type": "text",
          "placeholder": "Search manga..."
        },
        "sort": {
          "queryParam": "m_orderby",
          "type": "select",
          "label": "Sort by",
          "options": [
            {
              "name": "Relevance",
              "value": ""
            },
            {
              "name": "Popular",
              "value": "popular"
            },
            {
              "name": "Latest",
              "value": "latest"
            },
            {
              "name": "A-Z",
              "value": "alphabet"
            },
            {
              "name": "Rating",
              "value": "rating"
            }
          ]
        }
      }
    }
  },
  "contentIdPattern": "/manhwa/([^/]+)",
  "notes": "Manhwa Toon (Madara family). Pagination markup SAGA bukan wp-pagenavi: nav.navigation.paging-navigation > .nav-links > .nav-previous a = \"Older Posts\" (page+1), .nav-next a = \"Newer posts\" (page-1) - selector a[rel=next]/wp-pagenavi nol match di semua route listing. Situs tidak punya penanda total sama sekali (nol \"N results\"/wp-pagenavi span di page 1 maupun page 2) sehingga Home/Search + Pag + Total hanya bisa (next-only). Reader: 26 img .reading-content img.wp-manga-chapter-img @data-src (SSR, no script payload), nav a.next_page/a.prev_page pada .select-pagination .nav-links.",
  "features": {
    "search": true,
    "chapters": true,
    "download": true,
    "favorite": true,
    "comments": false,
    "related": false,
    "generatePdf": true,
    "offlineMode": true
  }
}
