{
  "source": "comicasuranet",
  "schemaVersion": "2.0",
  "version": "1.0.0",
  "enabled": true,
  "defaultLanguage": "english",
  "baseUrl": "https://comicasura.net",
  "ui": {
    "displayName": "Akaza Scans",
    "brandColor": "#FF6B35",
    "openInBrowserUrl": "https://manhwareads.com"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://comicasura.net/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    },
    "imageHeaders": {
      "Referer": "https://comicasura.net/"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/advanced-search",
        "list": {
          "container": "div.grid a[href^=\"https://comicasura.net/manga/\"]",
          "fields": {
            "id": {
              "selector": "a[href^=\"https://comicasura.net/manga/\"]",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": "img",
              "attribute": "alt"
            },
            "coverUrl": {
              "selector": "img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": "a[href*=\"?page=\"]"
          }
        }
      },
      "homePage": {
        "url": "/advanced-search?page={page}",
        "inherits": "home"
      },
      "search": {
        "url": "/advanced-search?name={query}",
        "list": {
          "container": "div.grid a[href^=\"https://comicasura.net/manga/\"]",
          "fields": {
            "id": {
              "selector": "a[href^=\"https://comicasura.net/manga/\"]",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": "img",
              "attribute": "alt"
            },
            "coverUrl": {
              "selector": "img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": "a[href*=\"?page=\"]"
          }
        }
      },
      "searchPage": {
        "url": "/advanced-search?name={query}&page={page}",
        "list": {
          "container": "div.grid a[href^=\"https://comicasura.net/manga/\"]",
          "fields": {
            "id": {
              "selector": "a[href^=\"https://comicasura.net/manga/\"]",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": "img",
              "attribute": "alt"
            },
            "coverUrl": {
              "selector": "img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": "a[href*=\"?page=\"]"
          }
        }
      },
      "genreSearch": {
        "url": "/genres/{tag}/",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/manga-genre/{tag}/page/{page}/",
        "inherits": "home"
      },
      "detail": "/manga/{id}",
      "chapter": "/manga/{id}"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "selector": "h1.comic-title-content"
          }
        },
        "chapters": {
          "container": "div.grid a[title^=\"Chapter\"]",
          "fields": {
            "id": {
              "selector": "a",
              "attribute": "href",
              "regex": "/manga/([^?#]+)"
            },
            "title": {
              "selector": "a",
              "attribute": "title"
            }
          }
        }
      },
      "reader": {
        "images": {
          "selector": "div.center img",
          "attribute": "src"
        }
      }
    },
    "searchForm": {
      "enabled": true,
      "urlPattern": "search",
      "params": {
        "query": {
          "queryParam": "s",
          "type": "text",
          "placeholder": "Search manga..."
        },
        "sort": {
          "queryParam": "m_orderby",
          "type": "select",
          "label": "Sort by",
          "options": [
            {
              "name": "Relevance",
              "value": ""
            },
            {
              "name": "Popular",
              "value": "popular"
            },
            {
              "name": "Latest",
              "value": "latest"
            },
            {
              "name": "A-Z",
              "value": "alphabet"
            },
            {
              "name": "Rating",
              "value": "rating"
            }
          ]
        }
      }
    }
  },
  "contentIdPattern": "/manga/([^/]+)",
  "features": {
    "search": false,
    "chapters": true,
    "download": true,
    "favorite": true,
    "comments": false,
    "related": false,
    "generatePdf": true,
    "offlineMode": true
  },
  "displayName": "Comicasura"
}