{
  "source": "mangareadorg",
  "schemaVersion": "2.0",
  "version": "1.0.1",
  "enabled": true,
  "defaultLanguage": "english",
  "baseUrl": "https://www.mangaread.org",
  "ui": {
    "displayName": "Mangaread",
    "brandColor": "#FF6B35",
    "openInBrowserUrl": "https://www.mangaread.org"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://www.mangaread.org/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    },
    "imageHeaders": {
      "Referer": "https://www.mangaread.org/"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/manga/",
        "list": {
          "container": ".page-item-detail",
          "fields": {
            "id": {
              "selector": ".item-thumb a[href*='/manga/'], .post-title a[href*='/manga/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".item-thumb img",
              "attribute": "src"
            }
          },
          "pagination": {
            "mode": "paged",
            "next": "a[rel='next'], .pagination .next.page-numbers, li.pagination-next a"
          }
        }
      },
      "homePage": {
        "url": "/manga/page/{page}/",
        "inherits": "home"
      },
      "search": {
        "url": "/?s={query}&post_type=wp-manga",
        "list": {
          "container": ".row.c-tabs-item__content",
          "fields": {
            "id": {
              "selector": "a[href*='/manga/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".tab-thumb img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": "a[rel='next'], .pagination .next.page-numbers, li.pagination-next a"
          }
        }
      },
      "searchPage": {
        "url": "/page/{page}/?s={query}&post_type=wp-manga",
        "list": {
          "container": ".row.c-tabs-item__content",
          "fields": {
            "id": {
              "selector": "a[href*='/manga/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".tab-thumb img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": "a[rel='next'], .pagination .next.page-numbers, li.pagination-next a"
          }
        }
      },
      "genreSearch": {
        "url": "/genres/{tag}/",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/genres/{tag}/page/{page}/",
        "inherits": "home"
      },
      "authorSearch": {
        "url": "/m-author/{tag}/",
        "inherits": "home"
      },
      "authorSearchPage": {
        "url": "/m-author/{tag}/page/{page}/",
        "inherits": "home"
      },
      "artistSearch": {
        "url": "/artist/{tag}/",
        "inherits": "home"
      },
      "artistSearchPage": {
        "url": "/artist/{tag}/page/{page}/",
        "inherits": "home"
      },
      "detail": "/manga/{id}/",
      "chapter": "/manga/{id}/"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "selector": ".post-title h1, h1"
          },
          "coverUrl": {
            "selector": ".summary_image img",
            "attribute": "src"
          },
          "description": {
            "selector": ".summary__content, .description-summary .summary__content"
          },
          "author": {
            "selector": ".author-content a",
            "multi": true
          },
          "artist": {
            "selector": ".artist-content a",
            "multi": true
          },
          "tags": {
            "selector": ".genres-content a",
            "multi": true
          }
        },
        "chapters": {
          "mode": "ajaxHtml",
          "container": "li.wp-manga-chapter",
          "fields": {
            "id": {
              "selector": "a",
              "attribute": "href",
              "regex": "/manga/([^?#]+)"
            },
            "title": {
              "selector": "a"
            },
            "date": {
              "selector": ".chapter-release-date i, .chapter-release-date a"
            }
          }
        }
      },
      "reader": {
        "mode": "chapterDataScript",
        "images": {
          "selector": ".reading-content img.wp-manga-chapter-img, .reading-content .page-break img",
          "attribute": "data-src"
        },
        "nav": {
          "next": ".next_page, .nav-links .next",
          "prev": ".prev_page, .nav-links .prev"
        }
      }
    },
    "searchForm": {
      "enabled": true,
      "urlPattern": "search",
      "params": {
        "query": {
          "queryParam": "s",
          "type": "text",
          "placeholder": "Search manga..."
        },
        "sort": {
          "queryParam": "m_orderby",
          "type": "select",
          "label": "Sort by",
          "options": [
            {
              "name": "Relevance",
              "value": ""
            },
            {
              "name": "Popular",
              "value": "popular"
            },
            {
              "name": "Latest",
              "value": "latest"
            },
            {
              "name": "A-Z",
              "value": "alphabet"
            },
            {
              "name": "Rating",
              "value": "rating"
            }
          ]
        }
      }
    }
  },
  "contentIdPattern": "/manga/([^/]+)",
  "features": {
    "search": true,
    "chapters": true,
    "download": true,
    "favorite": true,
    "comments": false,
    "related": false,
    "generatePdf": true,
    "offlineMode": true
  }
}