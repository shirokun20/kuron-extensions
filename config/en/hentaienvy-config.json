{
  "source": "hentaienvy",
  "idType": "real",
  "schemaVersion": "2.0",
  "version": "1.0.4",
  "enabled": true,
  "defaultLanguage": "english",
  "configUrl": "",
  "baseUrl": "https://hentaienvy.com",
  "ui": {
    "displayName": "HentaiEnvy",
    "iconPath": "./images/hentaienvy.png",
    "brandColor": "#EC4899",
    "openInBrowserUrl": "https://hentaienvy.com"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://hentaienvy.com/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    },
    "imageHeaders": {
      "Referer": "https://hentaienvy.com/"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/",
        "list": {
          "container": ".thumb",
          "fields": {
            "id": {
              "selector": ".thumb > a[href*='/gallery/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".hnv-gallery-card__title a"
            },
            "coverUrl": {
              "selector": ".hnv-gallery-card__media img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": ".pagination .page-item a[rel='next'], .pagination li:last-child a"
          }
        }
      },
      "homePage": {
        "url": "/?page={page}",
        "inherits": "home"
      },
      "search": {
        "url": "/search/?s_key={query}",
        "inherits": "home"
      },
      "searchPage": {
        "url": "/search/?s_key={query}&page={page}",
        "inherits": "home"
      },
      "genreSearch": {
        "url": "/category/{tag}/",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/category/{tag}/?page={page}",
        "inherits": "home"
      },
      "languageSearch": {
        "url": "/language/{tag}/",
        "inherits": "home"
      },
      "languageSearchPage": {
        "url": "/language/{tag}/?page={page}",
        "inherits": "home"
      },
      "detail": "/gallery/{id}/",
      "chapter": "/gallery/{id}/"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "transform": "cleanText",
            "selector": "h1"
          },
          "coverUrl": {
            "selector": ".hnv-gallery-cover img",
            "attribute": "src"
          },
          "pageCount": {
            "selector": "span.hnv-gallery-entity-items",
            "regex": "(\\d+)"
          },
          "tags": {
            "selector": "a.hnv-gallery-tag",
            "attribute": "href",
            "transform": "slug",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "tag"
          }
        }
      },
      "reader": {
        "mode": "hentaifoxCdn",
        "readerPageUrlPattern": "/g/{id}/1/",
        "readerImageSelector": "#readerImg",
        "readerImageAttr": "src",
        "readerPageCountSelector": "#readerApp",
        "readerPageCountAttr": "data-reader-total",
        "thumbSelector": ".hnv-gallery-thumb__img",
        "thumbSrcAttr": "src",
        "cdnPathRegex": "(?:https?:)?//([^/]+)/(.+?)/\\d+t\\.(?:jpg|webp)"
      }
    }
  },
  "contentIdPattern": "/gallery/(\\d+)",
  "features": {
    "comments": false,
    "related": false,
    "download": true,
    "favorite": true,
    "chapters": false,
    "offlineMode": true,
    "generatePdf": true
  },
  "searchForm": {
    "urlPattern": "search",
    "params": {
      "query": {
        "queryParam": "s_key",
        "type": "text",
        "placeholder": "Search title or tag..."
      }
    }
  },
  "notes": "Rebuilt 2026-11-23 for the site redesign (hnv-gallery-card markup, /category/ taxonomy + /language/ routes, #readerImg + #readerApp[data-reader-total] reader, span.hnv-gallery-entity-items page count). Live-verified: home/search/category/language lists + pagination, gallery detail fields + tags (a.hnv-gallery-tag), /g/ reader JSON (58 pages on sample). Old /tag/ route still 200 (legacy) but tags now link to /category/ + /language/."
}
