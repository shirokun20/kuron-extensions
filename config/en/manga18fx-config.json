{
  "source": "manga18fx",
  "schemaVersion": "2.0",
  "version": "1.0.2",
  "enabled": true,
  "defaultLanguage": "english",
  "baseUrl": "https://manga18fx.com",
  "ui": {
    "displayName": "Manga18fx",
    "brandColor": "#FF6B35",
    "openInBrowserUrl": "https://manga18fx.com"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://manga18fx.com/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    },
    "imageHeaders": {
      "Referer": "https://manga18fx.com/"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/",
        "list": {
          "container": ".bsx-item",
          "fields": {
            "id": {
              "selector": "a",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": "a",
              "attribute": "title"
            },
            "coverUrl": {
              "selector": "img",
              "attribute": "src"
            }
          },
          "pagination": {
            "mode": "paged",
            "next": "a[rel='next'], .pagination .next.page-numbers, li.pagination-next a, .pagination li.next a"
          }
        }
      },
      "homePage": {
        "url": "/page/{page}/",
        "inherits": "home"
      },
      "search": {
        "url": "/search?q={query}",
        "list": {
          "container": ".bsx-item",
          "fields": {
            "id": {
              "selector": ".thumb-manga a, h3.tt a",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": "h3.tt a",
              "attribute": "title"
            },
            "coverUrl": {
              "selector": ".thumb-manga img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": ".pagination li.next a"
          }
        }
      },
      "searchPage": {
        "url": "/search?q={query}&page={page}",
        "list": {
          "container": ".bsx-item",
          "fields": {
            "id": {
              "selector": ".thumb-manga a, h3.tt a",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": "h3.tt a",
              "attribute": "title"
            },
            "coverUrl": {
              "selector": ".thumb-manga img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": ".pagination li.next a"
          }
        }
      },
      "genreSearch": {
        "url": "/manga-genre/{tag}",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/manga-genre/{tag}?page={page}",
        "inherits": "home"
      },
      "detail": "/manga/{id}/",
      "chapter": "/manga/{id}"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "selector": "h1"
          },
          "coverUrl": {
            "selector": ".summary_image img",
            "attribute": "src"
          },
          "author": {
            "selector": ".author-content a",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "author"
          },
          "artist": {
            "selector": ".artist-content a",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "artist"
          },
          "tags": {
            "selector": ".genres-content a",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "tag"
          }
        },
        "chapters": {
          "container": "li.a-h",
          "fields": {
            "id": {
              "selector": "a.chapter-name",
              "attribute": "href",
              "regex": "/manga/([^?#]+?)/?$"
            },
            "title": {
              "selector": "a.chapter-name"
            },
            "date": {
              "selector": ".chapter-time"
            }
          }
        }
      },
      "reader": {
        "mode": "chapterDataScript",
        "images": {
          "selector": ".page-break img",
          "attribute": "data-src"
        },
        "nav": {
          "next": ".navi-change-chapter-btn-next, .next_page, .nav-links .next",
          "prev": ".navi-change-chapter-btn-prev, .prev_page, .nav-links .prev"
        }
      }
    },
    "searchForm": {
      "enabled": true,
      "urlPattern": "search",
      "params": {
        "query": {
          "queryParam": "q",
          "type": "text",
          "placeholder": "Search manga..."
        }
      }
    }
  },
  "contentIdPattern": "/manga/([^/]+)",
  "features": {
    "search": true,
    "chapters": true,
    "download": true,
    "favorite": true,
    "comments": false,
    "related": false,
    "generatePdf": true,
    "offlineMode": true
  },
  "displayName": "Manga18fx"
}
