{
  "source": "mangadistrict",
  "schemaVersion": "2.0",
  "version": "1.0.2",
  "enabled": true,
  "defaultLanguage": "english",
  "baseUrl": "https://mangadistrict.com",
  "ui": {
    "displayName": "Mangadistrict",
    "brandColor": "#FF6B35",
    "openInBrowserUrl": "https://mangadistrict.com"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://mangadistrict.com/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    },
    "imageHeaders": {
      "Referer": "https://mangadistrict.com/"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/series/",
        "list": {
          "container": ".page-item-detail",
          "fields": {
            "id": {
              "selector": ".item-thumb a[href*='/series/'], .post-title a[href*='/series/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".item-thumb img",
              "attribute": "src"
            }
          },
          "pagination": {
            "mode": "paged",
            "next": ".wp-pagenavi a.page.larger"
          }
        }
      },
      "homePage": {
        "url": "/series/page/{page}/",
        "inherits": "home"
      },
      "search": {
        "url": "/?s={query}&post_type=wp-manga",
        "list": {
          "container": ".page-item-detail",
          "fields": {
            "id": {
              "selector": ".item-thumb a[href*='/series/'], .post-title a[href*='/series/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".post-title h3 a, .post-title a"
            },
            "coverUrl": {
              "selector": ".item-thumb img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": ".wp-pagenavi a.page.larger"
          }
        }
      },
      "searchPage": {
        "url": "/page/{page}/?s={query}&post_type=wp-manga",
        "inherits": "search"
      },
      "genreSearch": {
        "url": "/publication-genre/{tag}/",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/publication-genre/{tag}/page/{page}/",
        "inherits": "home"
      },
      "tagSearch": {
        "url": "/publication-tag/{tag}/",
        "inherits": "home"
      },
      "tagSearchPage": {
        "url": "/publication-tag/{tag}/page/{page}/",
        "inherits": "home"
      },
      "detail": "/series/{id}/",
      "chapter": "/series/{id}"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "selector": ".post-title h1, h1"
          },
          "coverUrl": {
            "selector": ".summary_image img",
            "attribute": "src"
          },
          "description": {
            "selector": ".summary__content, .description-summary .summary__content"
          },
          "author": {
            "selector": ".author-content a",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "author"
          },
          "artist": {
            "selector": ".artist-content a",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "artist"
          },
          "tags": {
            "selector": ".genres-content a",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "tag"
          }
        },
        "chapters": {
          "container": "li.wp-manga-chapter",
          "fields": {
            "id": {
              "selector": "a",
              "attribute": "href",
              "regex": "/series/([^?#]+)"
            },
            "title": {
              "selector": "a"
            },
            "date": {
              "selector": ".chapter-release-date i, .chapter-release-date a"
            }
          }
        }
      },
      "reader": {
        "mode": "chapterDataScript",
        "images": {
          "selector": ".reading-content img.wp-manga-chapter-img:not(#image-99999), .reading-content .page-break img:not(#image-99999)",
          "attribute": "data-src"
        },
        "video": {
          "container": ".chapter-video-frame",
          "selector": "video source, video",
          "attribute": "src",
          "dataAttribute": "data-vvl-src",
          "requireChapterType": "chapter-type-video"
        },
        "nav": {
          "next": ".next_page, .nav-links .next",
          "prev": ".prev_page, .nav-links .prev"
        }
      }
    },
    "searchForm": {
      "urlPattern": "search",
      "params": {
        "query": {
          "queryParam": "s",
          "type": "text",
          "placeholder": "Search manga..."
        },
        "sort": {
          "queryParam": "m_orderby",
          "type": "select",
          "label": "Sort by",
          "options": [
            {
              "name": "Relevance",
              "value": ""
            },
            {
              "name": "Latest",
              "value": "latest"
            },
            {
              "name": "A-Z",
              "value": "alphabet"
            },
            {
              "name": "Rating",
              "value": "rating"
            },
            {
              "name": "Trending",
              "value": "trending"
            },
            {
              "name": "Views",
              "value": "views"
            },
            {
              "name": "Newest",
              "value": "new-manga"
            }
          ]
        }
      }
    }
  },
  "contentIdPattern": "/series/([^/]+)",
  "features": {
    "home": true,
    "search": true,
    "detail": true,
    "chapters": true,
    "reader": true,
    "contentByTag": true,
    "download": true,
    "favorite": true,
    "comments": false,
    "related": false,
    "generatePdf": true,
    "offlineMode": true
  }
}
