{
  "source": "hentairead",
  "displayName": "Hentairead",
  "schemaVersion": "2.0",
  "version": "1.0.6",
  "baseUrl": "https://hentairead.io",
  "enabled": true,
  "defaultLanguage": "english",
  "ui": {
    "displayName": "Hentairead",
    "iconPath": "/favicon-32x32.png",
    "brandColor": "#ffffff",
    "openInBrowserUrl": "https://hentairead.io"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://hentairead.io/",
      "User-Agent": "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.6099.230 Mobile Safari/537.36"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 2,
      "maxConcurrentRequests": 2
    }
  },
  "configUrl": "https://raw.githubusercontent.com/shirokun20/kuron-config-providers/main/configs/hentairead.io-config.json",
  "requiredPrimitives": [
    "imageMode.directUrl",
    "pagination.page",
    "auth.none"
  ],
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/",
        "list": {
          "container": ".owl-carousel .item, div.col-6.video",
          "fields": {
            "id": {
              "selector": "a",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": "img",
              "attribute": "alt"
            },
            "coverUrl": {
              "selector": "img",
              "attribute": "src",
              "prefix": "https://hentairead.io/"
            }
          }
        }
      },
      "homePage": {
        "url": "/?act=home&pageNum={page}",
        "inherits": "home"
      },
      "search": {
        "url": "/?act=search&f[status]=all&f[sortby]=lastest-chap&f[keyword]={query}",
        "inherits": "home"
      },
      "searchPage": {
        "url": "/?act=search&f[status]=all&f[sortby]=lastest-chap&f[keyword]={query}&pageNum={page}",
        "inherits": "home"
      },
      "detail": "/{id}/",
      "chapter": "/{id}",
      "genreSearch": {
        "url": "/genres/{tag}/",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/?act=search&f[genres]={tag}&pageNum={page}",
        "inherits": "home"
      }
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "selector": "h1"
          },
          "coverUrl": {
            "selector": "meta[property=\"og:image\"]",
            "attribute": "content"
          },
          "tags": {
            "selector": ".breadcrumb-item a[href*='/genres/']:not([href='/genres/'])",
            "attribute": "href",
            "transform": "slug",
            "multi": true,
            "extractTagObjects": true
          }
        },
        "chapters": {
          "container": "#nt_listchapter",
          "fields": {
            "id": {
              "selector": "a",
              "attribute": "href",
              "regex": "/([^?#]+/chapter-\\d+-\\d+)"
            },
            "title": {
              "selector": "a"
            }
          }
        }
      },
      "reader": {
        "images": {
          "selector": "img[data-index]",
          "attribute": "src"
        }
      }
    }
  },
  "searchForm": {
    "urlPattern": "search",
    "params": {
      "query": {
        "queryParam": "f[keyword]",
        "type": "text",
        "placeholder": "Search..."
      }
    }
  },
  "contentIdPattern": "/([a-z0-9-]+-\\d+)/?",
  "navigation": {
    "genreQueryPrefix": "genre:",
    "genreTagType": "genre"
  },
  "features": {
    "home": true,
    "search": true,
    "detail": true,
    "reader": true,
    "download": true,
    "chapters": true,
    "comments": false,
    "favorite": true,
    "offlineMode": true,
    "related": false
  },
  "notes": "Custom PHP CMS, bukan Madara. Search asli: ?act=search&f[status]=all&f[sortby]=lastest-chap&f[keyword]= (endpoint ?act=ajax hanya autocomplete)."
}
