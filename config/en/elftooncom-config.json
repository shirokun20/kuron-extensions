{
  "source": "elftooncom",
  "schemaVersion": "2.0",
  "version": "1.0.2",
  "enabled": true,
  "defaultLanguage": "english",
  "baseUrl": "https://elftoon.net",
  "ui": {
    "displayName": "Elftoon",
    "brandColor": "#FF6B35",
    "openInBrowserUrl": "https://elftoon.net"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://elftoon.net/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    },
    "imageHeaders": {
      "Referer": "https://elftoon.net/"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/series",
        "list": {
          "container": "[data-card-set-item]",
          "fields": {
            "id": {
              "selector": "a[href*='?ref=browse']",
              "attribute": "href",
              "regex": "series/comic/([^?#]+)"
            },
            "title": {
              "selector": "h3"
            },
            "coverUrl": {
              "selector": "a[href*='?ref=browse'] img",
              "attribute": "src"
            }
          },
          "pagination": {
            "mode": "paged"
          }
        }
      },
      "homePage": {
        "url": "/series?page={page}",
        "inherits": "home"
      },
      "genreSearch": {
        "url": "/series?genre={tag}",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/series?genre={tag}&page={page}",
        "inherits": "home"
      },
      "detail": "/series/comic/{id}",
      "chapter": "/series/comic/{id}"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "selector": "[data-series-title] h1"
          },
          "coverUrl": {
            "selector": "[data-series-cover] img",
            "attribute": "src"
          },
          "tags": {
            "selector": "a[href*='/series?genre=']",
            "attribute": "href",
            "regex": "[?&]genre=([^&#]+)",
            "multi": true,
            "extractTagObjects": true,
            "tagType": "tag"
          }
        },
        "chapters": {
          "container": "[data-chapter-rows] [data-card-set-item]",
          "fields": {
            "id": {
              "selector": "a[href*='/chapter/']",
              "attribute": "href",
              "regex": "series/comic/([^?#]+/chapter/[^?#]+)"
            },
            "title": {
              "selector": "a[href*='/chapter/']"
            },
            "date": {
              "selector": "svg.lucide-clock + span"
            }
          }
        }
      }
    },
    "searchForm": {
      "enabled": true,
      "urlPattern": "search",
      "params": {
        "query": {
          "queryParam": "s",
          "type": "text",
          "placeholder": "Search manga..."
        },
        "sort": {
          "queryParam": "m_orderby",
          "type": "select",
          "label": "Sort by",
          "options": [
            {
              "name": "Relevance",
              "value": ""
            },
            {
              "name": "Popular",
              "value": "popular"
            },
            {
              "name": "Latest",
              "value": "latest"
            },
            {
              "name": "A-Z",
              "value": "alphabet"
            },
            {
              "name": "Rating",
              "value": "rating"
            }
          ]
        }
      }
    }
  },
  "contentIdPattern": "/series/comic/([^/]+)",
  "features": {
    "search": false,
    "chapters": true,
    "download": true,
    "favorite": true,
    "comments": false,
    "related": false,
    "generatePdf": true,
    "offlineMode": true
  },
  "displayName": "Elftoon",
  "notes": "Elftoon pindah total ke elftoon.net (Next.js rewrite, v1.0.2). Browse /series SSR 24 kartu [data-card-set-item] (id a[href*='?ref=browse'], judul h3, cover img@src); paginasi query ?page= (p1/p2 overlap 0) tapi TANPA markup paginator/total di DOM sehingga Home/Genre + Pag + Total hanya (next-only). Genre query ?genre= (case-sensitive, nonsense 0 kartu); arsip tag/author/artist terpisah TIDAK ADA (cuma chip /series?genre=). Detail /series/comic/{id}: judul [data-series-title] h1, cover [data-series-cover] img, daftar chapter SSR parsial (~13 terbaru, [data-chapter-rows]). Search /search?q= & reader /chapter/{n} 100% client-render (SSR 0 kartu/0 gambar, dibuktikan Playwright) sehingga Search & Reader = jujur mati."
}
