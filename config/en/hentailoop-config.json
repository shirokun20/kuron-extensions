{
  "source": "hentailoop",
  "displayName": "Hentailoop",
  "schemaVersion": "2.0",
  "version": "1.0.4",
  "baseUrl": "https://hentailoop.com",
  "enabled": true,
  "defaultLanguage": "english",
  "ui": {
    "displayName": "Hentailoop",
    "iconPath": "/favicon-32x32.png",
    "brandColor": "#ffffff",
    "openInBrowserUrl": "https://hentailoop.com"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://hentailoop.com/",
      "User-Agent": "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.6099.230 Mobile Safari/537.36"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 2,
      "maxConcurrentRequests": 2
    }
  },
  "configUrl": "https://raw.githubusercontent.com/shirokun20/kuron-config-providers/main/configs/hentailoop.com-config.json",
  "requiredPrimitives": [
    "imageMode.directUrl",
    "pagination.page",
    "auth.none"
  ],
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/",
        "list": {
          "container": "div.manga-card",
          "fields": {
            "id": {
              "selector": "a",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": "h2.title"
            },
            "coverUrl": {
              "selector": "img",
              "attribute": "data-src"
            }
          },
          "pagination": {
            "next": "a.next.page-numbers",
            "links": "a.page-numbers"
          }
        }
      },
      "homePage": {
        "url": "/page/{page}/",
        "inherits": "home"
      },
      "latest": {
        "url": "/",
        "inherits": "home"
      },
      "search": {
        "url": "/?s={query}&post_type=manga",
        "inherits": "home"
      },
      "searchPage": {
        "url": "/page/{page}/?s={query}&post_type=manga",
        "inherits": "home"
      },
      "detail": "/manga/{id}/",
      "chapter": "/manga/{id}/read/",
      "genreSearch": {
        "url": "/genres/{tag}/",
        "list": {
          "container": "div.cards-wrapp div.manga-card",
          "fields": {
            "id": {
              "selector": "a",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "selector": ".title"
            },
            "coverUrl": {
              "selector": "img",
              "attribute": "data-src"
            }
          },
          "pagination": {
            "mode": "paged",
            "next": "a.next.page-numbers",
            "links": "a.page-numbers"
          }
        }
      },
      "genreSearchPage": {
        "url": "/genres/{tag}/page/{page}/",
        "inherits": "genreSearch"
      },
      "tagSearch": {
        "url": "/tag/{tag}/",
        "inherits": "genreSearch"
      },
      "tagSearchPage": {
        "url": "/tag/{tag}/page/{page}/",
        "inherits": "tagSearch"
      },
      "artistSearch": {
        "url": "/artists/{tag}/",
        "inherits": "genreSearch"
      },
      "artistSearchPage": {
        "url": "/artists/{tag}/page/{page}/",
        "inherits": "artistSearch"
      }
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "selector": "h1"
          },
          "coverUrl": {
            "selector": "meta[property=\"og:image\"]",
            "attribute": "content"
          },
          "tags": {
            "selector": ".manga-term-content.tags a",
            "attribute": "href",
            "transform": "slug",
            "multi": true,
            "extractTagObjects": true
          }
        }
      },
      "reader": {
        "images": {
          "selector": "img.attachment-full",
          "attribute": "src"
        }
      }
    }
  },
  "searchForm": {
    "urlPattern": "search",
    "params": {
      "query": {
        "queryParam": "q",
        "type": "text",
        "placeholder": "Search..."
      }
    }
  },
  "contentIdPattern": "/manga/([^/]+)",
  "navigation": {
    "genreQueryPrefix": "genre:",
    "genreTagType": "genre",
    "tagQueryMapping": {
      "tag": {
        "mode": "name"
      }
    }
  },
  "features": {
    "home": true,
    "search": true,
    "detail": true,
    "reader": true,
    "download": true,
    "chapters": false,
    "comments": false,
    "favorite": true,
    "offlineMode": true,
    "related": false
  },
  "notes": "Theme mangaloop (bukan Madara). Single-gallery: 1 karya = 1 galeri, reader di .../read/ (display as list/gallery)."
}
