{
  "source": "nicomanga",
  "version": "1.3.0",
  "enabled": true,
  "defaultLanguage": "japanese",
  "baseUrl": "https://nicomanga.com",
  "configUrl": "./config/nicomanga-config.json",
  "ui": {
    "displayName": "Nicomanga",
    "iconPath": "./images/nicomanga.png",
    "brandColor": "#FF7043"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://nicomanga.com/",
      "User-Agent": "Mozilla/5.0"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/manga-list.html?p={page}&v=grid",
        "list": {
          "container": ".manga-grid .manga-card",
          "fields": {
            "id": {
              "selector": "a.manga-title",
              "attribute": "href"
            },
            "title": {
              "selector": ".manga-title"
            },
            "coverUrl": {
              "selector": "img.manga-img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": ".custom-pagination .page-link.next:not(.disabled)",
            "links": ".custom-pagination .page-link"
          }
        }
      },
      "popular": {
        "url": "/manga-list.html?pr=popular&p={page}&v=grid",
        "inherits": "home"
      },
      "latest": {
        "url": "/manga-list.html?pr=new&p={page}&v=grid",
        "inherits": "home"
      },
      "search": {
        "url": "/manga-list.html?n={query}&p={page}&v=grid",
        "inherits": "home"
      },
      "searchPage": {
        "url": "/manga-list.html?n={query}&p={page}&v=grid",
        "inherits": "home"
      },
      "genreSearch": {
        "url": "/manga-list.html?g={tag}&v=grid",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/manga-list.html?g={tag}&v=grid",
        "inherits": "home"
      },
      "detail": "/{id}",
      "chapter": "/{id}"
    },
    "selectors": {
      "detail": {
        "chaoticKey": "NicoMangaX2",
        "fields": {
          "title": {
            "selector": ".manga-cover-image",
            "attribute": "alt"
          },
          "coverUrl": {
            "selector": ".manga-cover-image",
            "attribute": "src"
          },
          "author": {
            "selector": ".info-field-label:contains(Author) + .info-field-value a",
            "transform": "base64"
          },
          "tags": {
            "selector": ".info-field-label:contains(Genre) + .info-field-value a",
            "multi": true,
            "transform": "base64"
          },
          "artist": {
            "selector": ".info-field-label:contains(Magazine) + .info-field-value a",
            "transform": "base64"
          },
          "status": {
            "selector": ".info-field-label:contains(Status) + .info-field-value a"
          },
          "description": {
            "selector": ".description-text-content"
          }
        },
        "chapters": {
          "container": "#chapter-grid .chapter-grid-item",
          "fields": {
            "id": {
              "selector": "self",
              "attribute": "href"
            },
            "title": {
              "selector": ".chapter-name-grid"
            },
            "date": {
              "selector": ".chapter-time-grid"
            }
          }
        }
      },
      "reader": {
        "mode": "chaoticPayload",
        "chaoticKey": "NicoMangaX2",
        "container": "#chapter_images_container",
        "images": {
          "selector": "#chapter_images_container img.chapter-img, #chapter_images_container img",
          "attribute": "src"
        },
        "nav": {
          "next": ".control-button.next-chapter, .page-nav-btn.chapter-btn[title*='Next']",
          "prev": ".control-button.prev-chapter, .page-nav-btn.chapter-btn[title*='Previous']"
        }
      }
    }
  },
  "features": {
    "comments": false,
    "related": false,
    "download": true,
    "favorite": true,
    "chapters": true,
    "generatePdf": true,
    "offlineMode": true,
    "advancedSearch": false
  },
  "searchForm": {
    "urlPattern": "search",
    "params": {
      "query": {
        "queryParam": "n",
        "type": "text",
        "placeholder": "Search manga..."
      },
      "page": {
        "queryParam": "p",
        "type": "page"
      }
    }
  },
  "contentIdPattern": "/manga-?\\d+/([^.]+\\.html)"
}
