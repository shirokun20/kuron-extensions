{
  "source": "nicomanga",
  "extends": "nextjs-adframe",
  "idType": "slug",
  "version": "1.3.5",
  "enabled": true,
  "defaultLanguage": "japanese",
  "baseUrl": "https://nicomanga.com",
  "configUrl": "./config/nicomanga-config.json",
  "ui": {
    "displayName": "Nicomanga",
    "iconPath": "./images/nicomanga.png",
    "brandColor": "#FF7043"
  },
  "network": {
    "requiresBypass": false,
    "headers": {
      "Referer": "https://nicomanga.com/",
      "User-Agent": "Mozilla/5.0"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/manga-list.html?p={page}&v=grid",
        "list": {
          "secondaryFetch": {
            "enabled": true,
            "tokenPattern": "payloadKey\\D{0,8}([lmc]_[a-f0-9]+)",
            "url": "{origin}/ad-frame/data?k={key}",
            "referer": "page",
            "payloadPath": "items",
            "decodeKey": "NicoManga",
            "itemsPath": "items",
            "imagesPath": "images",
            "itemFields": {
              "id": {
                "path": "ur",
                "regex": "^/?(.*)$"
              },
              "title": {
                "path": "n",
                "transform": "cleanText"
              },
              "coverUrl": {
                "path": "c"
              }
            },
            "pagination": {
              "page": "pagination.page",
              "total": "pagination.total",
              "lastPage": "pagination.last_page"
            }
          },
          "container": ".manga-grid .manga-card",
          "fields": {
            "id": {
              "selector": "a.manga-title",
              "attribute": "href"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".manga-title"
            },
            "coverUrl": {
              "selector": "a.manga-cover img",
              "attribute": "src"
            }
          },
          "pagination": {
            "next": ".custom-pagination .page-link.next:not(.disabled)",
            "links": ".custom-pagination .page-link"
          }
        }
      },
      "popular": {
        "url": "/manga-list.html?pr=popular&p={page}&v=grid",
        "inherits": "home"
      },
      "latest": {
        "url": "/manga-list.html?pr=new&p={page}&v=grid",
        "inherits": "home"
      },
      "search": {
        "url": "/manga-list.html?n={query}&p={page}&v=grid",
        "inherits": "home"
      },
      "searchPage": {
        "url": "/manga-list.html?n={query}&p={page}&v=grid",
        "inherits": "home"
      },
      "genreSearch": {
        "url": "/manga-list.html?g={tag}&v=grid",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/manga-list.html?g={tag}&v=grid",
        "inherits": "home"
      },
      "tagSearch": {
        "url": "/g/{tag}.html",
        "tagTransform": "base64",
        "inherits": "home"
      },
      "tagSearchPage": {
        "url": "/g/{tag}.html?p={page}",
        "inherits": "home"
      },
      "detail": "/{id}",
      "chapter": "/{id}"
    },
    "selectors": {
      "detail": {
        "chaoticKey": "NicoMangaX2",
        "secondaryFetch": {
          "enabled": true,
          "tokenPattern": "payloadKey\\D{0,8}([lmc]_[a-f0-9]+)",
          "url": "{origin}/ad-frame/data?k={key}",
          "referer": "page",
          "payloadPath": "chaotic_payload",
          "decodeKey": "NicoMangaX2"
        },
        "fields": {
          "title": {
            "transform": "cleanText",
            "selector": "article.ssr-seo-content h1[itemprop=name]"
          },
          "coverUrl": {
            "selector": "article.ssr-seo-content meta[itemprop=image]",
            "attribute": "content"
          },
          "author": {
            "selector": "article.ssr-seo-content meta[itemprop=author]",
            "attribute": "content",
            "multi": true
          },
          "tags": {
            "selector": "article.ssr-seo-content p:contains(Genres)",
            "regex": "Genres:\\s*(.+)",
            "multi": true
          },
          "artist": {
            "selector": "article.ssr-seo-content meta[itemprop=artist]",
            "attribute": "content",
            "multi": true
          },
          "status": {
            "selector": "article.ssr-seo-content p:contains(Status)"
          },
          "description": {
            "selector": "article.ssr-seo-content p[itemprop=description]"
          }
        },
        "chapters": {
          "container": "nav[aria-label=\"Chapters\"] a",
          "fields": {
            "id": {
              "selector": "self",
              "attribute": "href"
            },
            "title": {
              "transform": "cleanText",
              "selector": "self"
            },
            "date": {
              "selector": "time"
            }
          }
        }
      },
      "reader": {
        "mode": "chaoticPayload",
        "chaoticKey": "NicoMangaX2",
        "secondaryFetch": {
          "enabled": true,
          "tokenPattern": "payloadKey\\D{0,8}([lmc]_[a-f0-9]+)",
          "url": "{origin}/ad-frame/data?k={key}",
          "referer": "page",
          "payloadPath": "chaotic_payload",
          "decodeKey": "NicoMangaX2",
          "imagesPath": "images"
        },
        "container": "div.chapter-image-wrapper",
        "images": {
          "selector": "img.chapter-img",
          "attribute": "src"
        },
        "nav": {
          "next": ".control-button.next-chapter, .page-nav-btn.chapter-btn[title*='Next']",
          "prev": ".control-button.prev-chapter, .page-nav-btn.chapter-btn[title*='Previous']"
        }
      }
    }
  },
  "features": {
    "comments": false,
    "related": false,
    "download": true,
    "favorite": true,
    "chapters": true,
    "generatePdf": true,
    "offlineMode": true,
    "advancedSearch": false
  },
  "searchForm": {
    "urlPattern": "search",
    "params": {
      "query": {
        "queryParam": "n",
        "type": "text",
        "placeholder": "Search manga..."
      },
      "page": {
        "queryParam": "p",
        "type": "page"
      }
    }
  },
  "contentIdPattern": "/((?:manga\\d+/)[^?#\\s\"]+\\.html|[a-f0-9]+\\.html)"
}
