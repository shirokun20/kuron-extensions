{
  "source": "manga18.club",
  "idType": "slug",
  "version": "1.0.5",
  "enabled": true,
  "defaultLanguage": "english",
  "baseUrl": "https://manga18.club",
  "configUrl": "",
  "ui": {
    "displayName": "Manga18 Club",
    "iconPath": "./images/manga18.png",
    "brandColor": "#B71C1C"
  },
  "network": {
    "requiresBypass": true,
    "headers": {
      "Referer": "https://manga18.club/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
      "Accept-Language": "en-US,en;q=0.9"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerSecond": 1,
      "maxConcurrentRequests": 2
    },
    "imageHeaders": {
      "Referer": "https://manga18.club/"
    }
  },
  "scraper": {
    "enabled": true,
    "urlPatterns": {
      "home": {
        "url": "/list-manga/{page}",
        "list": {
          "container": ".recoment_box .col-md-3, .recoment_box .col-sm-3, .recoment_box .col-sm-4, .recoment_box .col-xs-6",
          "fields": {
            "id": {
              "selector": ".mg_name a, .story_images a[href*='/manhwa/']",
              "attribute": "href",
              "transform": "slug"
            },
            "title": {
              "transform": "cleanText",
              "selector": ".mg_name a"
            },
            "coverUrl": {
              "selector": ".story_images img",
              "attribute": "src"
            }
          },
          "idFallbackSelectors": [
            ".mg_name a",
            ".story_images a",
            "a[href*='/manhwa/']"
          ],
          "pagination": {
            "next": ".pagination li.active + li a",
            "links": ".pagination a"
          }
        }
      },
      "homePage": {
        "url": "/list-manga/{page}",
        "inherits": "home"
      },
      "search": {
        "url": "/list-manga/?search={query}",
        "inherits": "home"
      },
      "searchPage": {
        "url": "/list-manga/?search={query}&page={page}",
        "inherits": "home"
      },
      "genreSearch": {
        "url": "/manga-list/{tag}",
        "inherits": "home"
      },
      "genreSearchPage": {
        "url": "/manga-list/{tag}/{page}",
        "inherits": "home"
      },
      "detail": "/manhwa/{id}",
      "chapter": "/manhwa/{id}"
    },
    "selectors": {
      "detail": {
        "fields": {
          "title": {
            "transform": "cleanText",
            "selector": ".detail_name h1, h1, h1.entry-title"
          },
          "coverUrl": {
            "selector": ".detail_avatar img, img[src*='/cover/'], img.thumb",
            "attribute": "src"
          },
          "uploadDate": {
            "selector": ".meta time, .meta .date, time"
          },
          "views": {
            "selector": ".detail_listInfo .item .info_value span, .meta .views, .views, .post-views",
            "regex": "([\\d,.]+)"
          },
          "tags": {
            "selector": ".detail_listInfo .item .info_value a[href*='/manga-list/'], .genres a",
            "multi": true,
            "extractTagObjects": true
          },
          "description": {
            "selector": ".detail_reviewContent, .detail_block .detail_reviewContent, .summary, .desc, .entry-content, .sinopsis"
          }
        },
        "chapters": {
          "container": ".chapter_box li, .detail_chapterContent .chapter_box li, .detail_chapterContent ul li",
          "fields": {
            "id": {
              "selector": "a.chapter_num, a",
              "attribute": "href",
              "regex": "/manhwa/([^/?#]+/[^/?#]+)"
            },
            "title": {
              "transform": "cleanText",
              "selector": "a.chapter_num, a"
            },
            "date": {
              "selector": ".chapter_info"
            }
          }
        }
      },
      "reader": {
        "container": ".chapter_boxImages, #chapter_boxImages",
        "images": {
          "selector": ".chapter_boxImages img, #chapter_boxImages img",
          "attribute": "src"
        },
        "nav": {
          "next": {
            "selector": "script",
            "regex": "var\\s+next_chapter\\s*=\\s*\"https?://[^/]+/manhwa/([^\"?#]+/[^\"?#/]+)\""
          },
          "prev": {
            "selector": "script",
            "regex": "var\\s+prev_chapter\\s*=\\s*\"https?://[^/]+/manhwa/([^\"?#]+/[^\"?#/]+)\""
          }
        },
        "heavyImageAutoSwitch": false
      }
    }
  },
  "searchForm": {
    "urlPattern": "search",
    "params": {
      "query": {
        "queryParam": "search",
        "type": "text",
        "placeholder": "Search..."
      },
      "page": {
        "queryParam": "page",
        "type": "page"
      }
    }
  },
  "contentIdPattern": "/manhwa/([^/]+)",
  "features": {
    "comments": true,
    "related": false,
    "download": true,
    "favorite": true,
    "chapters": true,
    "offlineMode": true,
    "generatePdf": true
  },
  "notes": "2026-11-23: requiresBypass:true + browser headers (issue #12; home returns 403 cf-mitigated via curl). Chapter modeling kept (/manhwa/{id} with two-segment ids from chapter list regex) but chapter list/detail could NOT be re-verified without bypass — needs live re-verify through the app before closing #12."
}
