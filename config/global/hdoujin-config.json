      },
      "language": {
        "mode": "rawParam",
        "param": "s",
        "valueSource": "tagName",
        "valuePrefix": "language:\"^",
        "valueSuffix": "$\""
      },
      "other": {
        "mode": "rawParam",
        "param": "s",
        "valueSource": "tagName",
        "valuePrefix": "other:\"^",
        "valueSuffix": "$\""
      },
      "reclass": {
        "mode": "rawParam",
        "param": "s",
        "valueSource": "tagName",
        "valuePrefix": "reclass:\"^",
        "valueSuffix": "$\""
      },
      "0": {
