        "valuePrefix": "cosplayer:\"^",
        "valueSuffix": "$\""
      },
      "uploader": {
        "mode": "rawParam",
        "param": "s",
        "valueSource": "tagName",
        "valuePrefix": "uploader:\"^",
        "valueSuffix": "$\""
      },
      "male": {
        "mode": "rawParam",
        "param": "s",
        "valueSource": "tagName",
        "valuePrefix": "male:\"^",
        "valueSuffix": "$\""
      },
      "female": {
        "mode": "rawParam",
        "param": "s",
